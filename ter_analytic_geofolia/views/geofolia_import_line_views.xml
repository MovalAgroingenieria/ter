<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_geofolia_import_line_search" model="ir.ui.view">
        <field name="name">geofolia.import.line.search</field>
        <field name="model">geofolia.import.line</field>
        <field name="arch" type="xml">
            <search string="Geofolia Import Lines">
                <field name="name" string="Name"/>
                <field name="code"/>
                <field name="farm_identification_code"/>
                <field name="external_uuid"/>
                <field name="job_id"/>
                <field name="sync_message"/>
                <separator/>
                <filter name="filter_pending" string="Pending"
                        domain="[('sync_state', '=', 'pending')]"/>
                <filter name="filter_error" string="Error"
                        domain="[('sync_state', '=', 'error')]"/>
                <filter name="filter_created_updated" string="Created / Updated"
                        domain="[('sync_state', 'in', ['created', 'updated'])]"/>
                <filter name="filter_skipped" string="Skipped"
                        domain="[('sync_state', '=', 'skipped')]"/>
                <filter name="filter_no_action" string="No action"
                        domain="[('sync_state', '=', 'no_action')]"/>
                <separator/>
                <filter name="filter_has_error_message" string="With error message"
                        domain="[('sync_message', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_job" string="Job"
                            context="{'group_by': 'job_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_geofolia_import_line_list" model="ir.ui.view">
        <field name="name">geofolia.import.line.list</field>
        <field name="model">geofolia.import.line</field>
        <field name="arch" type="xml">
            <list decoration-success="sync_state in ('created', 'updated')"
                  decoration-warning="sync_state in ('pending', 'skipped', 'no_action')"
                  decoration-danger="sync_state == 'error'"
                  default_order="job_id desc, id asc">
                <header>
                    <button name="action_apply_selected" type="object"
                            string="Apply selected" class="btn-primary"/>
                </header>
                <field name="sync_state"/>
                <field name="sync_message" string="Error / message"/>
                <field name="job_id" optional="hide"/>
                <field name="import_type" optional="hide"/>
                <field name="external_uuid"/>
                <field name="farm_identification_code" optional="show"/>
                <field name="code"/>
                <field name="name"/>
                <field name="city"/>
                <field name="crop_name"/>
                <field name="area"/>
                <field name="harvest_year"/>
                <field name="fsm_location_id" optional="hide"/>
                <field name="ter_use_unit_id" optional="hide"/>
                <field name="unit_symbol" optional="hide"/>
                <field name="category_enum" optional="hide"/>
                <field name="raw_json_text" optional="hide" string="JSON"/>
            </list>
        </field>
    </record>

    <record id="view_geofolia_import_line_form" model="ir.ui.view">
        <field name="name">geofolia.import.line.form</field>
        <field name="model">geofolia.import.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="job_id" readonly="1"/>
                            <field name="import_type" readonly="1"/>
                            <field name="sync_state"/>
                            <field name="sync_message"/>
                            <field name="external_uuid"/>
                            <field name="farm_identification_code"/>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="city"/>
                            <field name="crop_name"/>
                            <field name="area"/>
                            <field name="harvest_year"/>
                            <field name="fsm_location_id"/>
                            <field name="ter_use_unit_id"/>
                        </group>
                    </group>
                    <group string="JSON" colspan="2">
                        <field name="raw_json_text" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_geofolia_import_line" model="ir.actions.act_window">
        <field name="name">Import Lines</field>
        <field name="res_model">geofolia.import.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_geofolia_import_line_search"/>
    </record>

    <menuitem id="menu_geofolia_import_lines"
              name="Lines"
              parent="ter_analytic_geofolia.menu_geofolia_import"
              action="action_geofolia_import_line"
              groups="group_geofolia_import"
              sequence="15"/>
</odoo>
