<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_geofolia" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.geofolia</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_ter.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='base_ter']" position="inside">
                <block title="Geofolia import" name="geofolia_import_defaults">
                    <setting id="geofolia_default_parcel_id"
                             string="Default parcel (Fields without geometry)"
                             help="Default parcel for ter.use_unit when importing Geofolia Fields without geometry.">
                        <field name="geofolia_default_parcel_id" options="{'no_create': True}"/>
                    </setting>
                    <setting id="geofolia_default_date_range_id"
                             string="Default date range (Fields)"
                             help="Default date range for ter.use_unit when importing Geofolia Fields.">
                        <field name="geofolia_default_date_range_id" options="{'no_create': True}"/>
                    </setting>
                    <setting id="geofolia_default_fsm_location_id"
                             string="Default FSM location (Activities)"
                             help="Fallback location for fsm.order when the activity's plot (CropZoneIds) is not yet imported. If Fields are imported first, the order uses the plot's fsm.location.">
                        <field name="geofolia_default_fsm_location_id" options="{'no_create': True}"/>
                    </setting>
                    <setting id="geofolia_default_harvested_product_id"
                             string="Default harvested product (no id)"
                             help="Product to assign when a Harvested product line has no Geofolia id.">
                        <field name="geofolia_default_harvested_product_id" options="{'no_create': True}"/>
                    </setting>
                    <setting id="geofolia_default_analytic_account_id"
                             string="Default analytic account (Activities / timesheets)"
                             help="Required to create timesheet lines from Geofolia activities (Odoo 18).">
                        <field name="geofolia_default_analytic_account_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
