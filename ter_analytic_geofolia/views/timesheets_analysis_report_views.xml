<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_timesheet_report_search" model="ir.ui.view">
        <field name="name">timesheets.analysis.report.search.inherit.geofolia</field>
        <field name="model">timesheets.analysis.report</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_report_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="geofolia_external_id" string="Geofolia ID"/>
                <filter name="filter_from_geofolia" string="From Geofolia"
                        domain="[('geofolia_external_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
