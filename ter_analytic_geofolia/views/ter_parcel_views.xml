<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ter_parcel_view_form" model="ir.ui.view">
        <field name="name">ter.parcel.view.form.inherit.geofolia</field>
        <field name="model">ter.parcel</field>
        <field name="inherit_id" ref="base_ter.ter_parcel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='official_code']" position="after">
                <field name="geofolia_created" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="ter_parcel_view_tree" model="ir.ui.view">
        <field name="name">ter.parcel.view.list.inherit.geofolia</field>
        <field name="model">ter.parcel</field>
        <field name="inherit_id" ref="base_ter.ter_parcel_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='municipality_id']" position="after">
                <field name="geofolia_created" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="ter_parcel_view_search" model="ir.ui.view">
        <field name="name">ter.parcel.view.search.inherit.geofolia</field>
        <field name="model">ter.parcel</field>
        <field name="inherit_id" ref="base_ter.ter_parcel_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='mapped_to_polygon_no']" position="after">
                <separator/>
                <filter name="filter_from_geofolia"
                        string="Created from Geofolia"
                        domain="[('geofolia_created', '=', True)]"/>
            </xpath>
            <xpath expr="//filter[@name='grouped_by_municipality_id']" position="after">
                <filter name="grouped_by_geofolia_created"
                        string="Created from Geofolia"
                        context="{'group_by': 'geofolia_created'}"/>
            </xpath>
        </field>
    </record>
</odoo>
