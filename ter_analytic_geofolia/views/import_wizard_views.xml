<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_geofolia_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Geofolia JSON</field>
        <field name="res_model">geofolia.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_geofolia_import_wizard_form" model="ir.ui.view">
        <field name="name">geofolia.import.wizard.form</field>
        <field name="model">geofolia.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Geofolia JSON">
                <group>
                    <field name="import_type"/>
                    <field name="file_name"/>
                    <field name="file_data" filename="file_name"/>
                </group>
                <footer>
                    <button name="action_import" type="object" class="btn-primary" string="Import data"/>
                    <button special="cancel" class="btn-secondary" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
