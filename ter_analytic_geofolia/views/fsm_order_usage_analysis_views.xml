                <attribute name="create">0</attribute>
                <attribute name="delete">0</attribute>
            </list>
            <field name="sequence" position="after">
                <field name="fsm_order_id"/>
                <field name="partner_id" optional="hide"/>
            </field>
        </field>
    </record>
    <record id="equipment_usage_analysis_search" model="ir.ui.view">
        <field name="name">fsm.order.equipment.usage.analysis.search</field>
        <field name="model">fsm.order.equipment.usage</field>
        <field name="arch" type="xml">
            <search>
                <field name="fsm_order_id"/>
                <field name="equipment_id"/>
                <field name="name"/>
                <field name="partner_id"/>
                <group string="Group By">
                    <filter name="by_order" string="Work Order" context="{'group_by': 'fsm_order_id'}"/>
                    <filter name="by_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="equipment_usage_pivot" model="ir.ui.view">
        <field name="name">fsm.order.equipment.usage.pivot</field>
        <field name="model">fsm.order.equipment.usage</field>
        <field name="arch" type="xml">
            <pivot string="Machinery">
                <field name="equipment_id" type="row"/>
                <field name="name" type="row"/>
                <field name="fsm_order_id" type="col"/>
                <field name="hours" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_equipment_usage_analysis" model="ir.actions.act_window">
        <field name="name">Machinery</field>
        <field name="res_model">fsm.order.equipment.usage</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="view_id" ref="equipment_usage_analysis_list"/>
        <field name="search_view_id" ref="equipment_usage_analysis_search"/>
    </record>

    <menuitem id="menu_usage_analysis" name="Work Order Details"
              parent="fieldservice.reporting" sequence="70"
              groups="fieldservice.group_fsm_user"/>
    <menuitem id="menu_product_usage_analysis" name="Raw Materials"
              parent="menu_usage_analysis" action="action_product_usage_analysis" sequence="10"/>
    <menuitem id="menu_harvest_usage_analysis" name="Harvest"
              parent="menu_usage_analysis" action="action_harvest_usage_analysis" sequence="20"/>
    <menuitem id="menu_worked_unit_analysis" name="Crop Units"
              parent="menu_usage_analysis" action="action_worked_unit_analysis" sequence="30"/>
    <menuitem id="menu_equipment_usage_analysis" name="Machinery"
              parent="menu_usage_analysis" action="action_equipment_usage_analysis" sequence="40"/>
</odoo>
