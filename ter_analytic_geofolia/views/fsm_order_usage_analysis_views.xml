                <field name="plot_code"/>
                <field name="billing_partner_id"/>
                <group string="Group By">
                    <filter name="by_order" string="Work Order" context="{'group_by': 'fsm_order_id'}"/>
                    <filter name="by_crop_unit" string="Crop Unit" context="{'group_by': 'use_unit_id'}"/>
                    <filter name="by_billing_holder" string="Billing Holder" context="{'group_by': 'billing_partner_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="worked_unit_pivot" model="ir.ui.view">
        <field name="name">fsm.order.worked.unit.pivot</field>
        <field name="model">fsm.order.worked.unit</field>
        <field name="arch" type="xml">
            <pivot string="Crop Units">
                <field name="billing_partner_id" type="row"/>
                <field name="use_unit_id" type="row"/>
                <field name="fsm_order_id" type="col"/>
                <field name="worked_surface" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_worked_unit_analysis" model="ir.actions.act_window">
        <field name="name">Crop Units</field>
        <field name="res_model">fsm.order.worked.unit</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="view_id" ref="worked_unit_analysis_list"/>
        <field name="search_view_id" ref="worked_unit_analysis_search"/>
    </record>

    <record id="equipment_usage_analysis_list" model="ir.ui.view">
        <field name="name">fsm.order.equipment.usage.analysis.list</field>
        <field name="model">fsm.order.equipment.usage</field>
        <field name="inherit_id" ref="fsm_order_equipment_usage_view_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list position="attributes">
