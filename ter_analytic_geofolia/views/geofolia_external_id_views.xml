<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_partner_tree_view_geofolia" model="ir.ui.view">
        <field name="name">res.partner.tree.geofolia</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[1]" position="after">
                <field name="geofolia_external_id" string="Geofolia ID" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="res_partner_form_view_geofolia" model="ir.ui.view">
        <field name="name">res.partner.form.geofolia</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Geofolia" name="geofolia_info">
                    <field name="geofolia_external_id" string="Geofolia ID" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="res_partner_search_view_geofolia" model="ir.ui.view">
        <field name="name">res.partner.search.geofolia</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="geofolia_external_id" string="Geofolia ID"/>
                <filter name="filter_from_geofolia" string="From Geofolia"
                        domain="[('geofolia_external_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_view_geofolia" model="ir.ui.view">
        <field name="name">product.product.tree.geofolia</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="geofolia_external_id" string="Geofolia ID" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="product_product_search_view_geofolia" model="ir.ui.view">
        <field name="name">product.product.search.geofolia</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="geofolia_external_id" string="Geofolia ID"/>
                <filter name="filter_from_geofolia" string="From Geofolia"
                        domain="[('geofolia_external_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_tree_view_geofolia" model="ir.ui.view">
        <field name="name">hr.employee.tree.geofolia</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="geofolia_external_id" string="Geofolia ID" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="hr_employee_search_view_geofolia" model="ir.ui.view">
        <field name="name">hr.employee.search.geofolia</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="geofolia_external_id" string="Geofolia ID"/>
                <filter name="filter_from_geofolia" string="From Geofolia"
                        domain="[('geofolia_external_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="fsm_person_list_view_geofolia" model="ir.ui.view">
        <field name="name">fsm.person.list.geofolia</field>
        <field name="model">fsm.person</field>
        <field name="inherit_id" ref="fieldservice.fsm_person_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="geofolia_external_id" string="Geofolia ID" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="fsm_person_search_view_geofolia" model="ir.ui.view">
        <field name="name">fsm.person.search.geofolia</field>
        <field name="model">fsm.person</field>
        <field name="inherit_id" ref="fieldservice.fsm_person_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="geofolia_external_id" string="Geofolia ID"/>
                <filter name="filter_from_geofolia" string="From Geofolia"
                        domain="[('geofolia_external_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="account_analytic_line_tree_view_geofolia" model="ir.ui.view">
        <field name="name">account.analytic.line.tree.geofolia</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-success">geofolia_external_id</attribute>
                <attribute name="decoration-muted">not geofolia_external_id</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="geofolia_external_id" string="Geofolia ID" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="account_analytic_line_search_view_geofolia" model="ir.ui.view">
        <field name="name">account.analytic.line.search.geofolia</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="geofolia_external_id" string="Geofolia ID"/>
                <filter name="filter_from_geofolia" string="From Geofolia"
                        domain="[('geofolia_external_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
