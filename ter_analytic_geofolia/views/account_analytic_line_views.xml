<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_analytic_line_tree" model="ir.ui.view">
        <field name="name">account.analytic.line.tree.inherit.geofolia</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="geofolia_external_id" string="Geofolia ID" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_analytic_line_filter" model="ir.ui.view">
        <field name="name">account.analytic.line.search.inherit.geofolia</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="geofolia_external_id" string="Geofolia ID"/>
                <filter name="filter_from_geofolia" string="From Geofolia"
                        domain="[('geofolia_external_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
