<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ter_use_unit_view_form" model="ir.ui.view">
        <field name="name">ter.use_unit.form.inherit.geofolia</field>
        <field name="model">ter.use_unit</field>
        <field name="inherit_id" ref="base_ter.ter_use_unit_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_fsm_orders" type="object"
                        class="oe_stat_button" icon="fa-wrench"
                        invisible="not fsm_location_id">
                    <field name="fsm_order_count" widget="statinfo"
                           string="Work Orders"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="fsm_location_id" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//page[@name='notes']" position="before">
                <page string="Geofolia" name="geofolia"
                      groups="ter_analytic_geofolia.group_geofolia_import">
                    <group string="Geofolia imported data">
                        <group>
                            <field name="geofolia_external_id" readonly="1"/>
                            <field name="geofolia_code" readonly="1"/>
                            <field name="geofolia_harvest_year" readonly="1"/>
                            <field name="geofolia_crop_name" readonly="1"/>
                            <field name="geofolia_city" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="ter_use_unit_view_list" model="ir.ui.view">
        <field name="name">ter.use_unit.list.inherit.geofolia</field>
        <field name="model">ter.use_unit</field>
        <field name="inherit_id" ref="base_ter.ter_use_unit_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="geofolia_external_id" string="Geofolia ID" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="ter_use_unit_view_search" model="ir.ui.view">
        <field name="name">ter.use_unit.search.inherit.geofolia</field>
        <field name="model">ter.use_unit</field>
        <field name="inherit_id" ref="base_ter.ter_use_unit_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="geofolia_external_id" string="Geofolia ID"/>
                <filter name="filter_from_geofolia" string="From Geofolia"
                        domain="[('geofolia_external_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
