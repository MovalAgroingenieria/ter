<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.geofolia</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Geofolia" name="geofolia">
                    <group>
                        <field name="geofolia_external_id" string="Geofolia ID" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_employee_tree" model="ir.ui.view">
        <field name="name">hr.employee.tree.inherit.geofolia</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="geofolia_external_id" string="Geofolia ID" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_employee_filter" model="ir.ui.view">
        <field name="name">hr.employee.search.inherit.geofolia</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="geofolia_external_id" string="Geofolia ID"/>
                <filter name="filter_from_geofolia" string="From Geofolia"
                        domain="[('geofolia_external_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
