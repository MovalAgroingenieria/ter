<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="geofolia_import_product_line_view_search" model="ir.ui.view">
        <field name="name">geofolia.import.product.line.search</field>
        <field name="model">geofolia.import.product.line</field>
        <field name="arch" type="xml">
            <search string="Product Lines">
                <field name="name"/>
                <field name="code"/>
                <field name="external_id"/>
                <field name="job_id"/>
                <filter name="filter_error" string="Error" domain="[('sync_state', '=', 'error')]"/>
                <filter name="filter_created" string="Created / Updated" domain="[('sync_state', 'in', ['created', 'updated'])]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_job" string="Job" context="{'group_by': 'job_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="geofolia_import_product_line_view_list" model="ir.ui.view">
        <field name="name">geofolia.import.product.line.list</field>
        <field name="model">geofolia.import.product.line</field>
        <field name="arch" type="xml">
            <list decoration-success="sync_state in ('created', 'updated')"
                  decoration-warning="sync_state in ('pending', 'skipped', 'no_action')"
                  decoration-danger="sync_state == 'error'"
                  default_order="job_id desc, id asc">
                <header>
                    <button name="action_apply_selected" type="object"
                            string="Apply selected" class="btn-primary"/>
                </header>
                <field name="sync_state"/>
                <field name="sync_message" optional="show"/>
                <field name="job_id"/>
                <field name="external_id"/>
                <field name="farm_identification_code" optional="show"/>
                <field name="code"/>
                <field name="name"/>
                <field name="product_id" optional="hide"/>
                <field name="raw_json_text" optional="hide" string="JSON"/>
            </list>
        </field>
    </record>

    <record id="geofolia_import_product_line_view_form" model="ir.ui.view">
        <field name="name">geofolia.import.product.line.form</field>
        <field name="model">geofolia.import.product.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="job_id" readonly="1"/>
                            <field name="sync_state"/>
                            <field name="sync_message"/>
                            <field name="external_id"/>
                            <field name="farm_identification_code"/>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="product_id"/>
                        </group>
                    </group>
                    <group string="JSON" colspan="2">
                        <field name="raw_json_text" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_geofolia_import_product_line" model="ir.actions.act_window">
        <field name="name">Product Lines</field>
        <field name="res_model">geofolia.import.product.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="geofolia_import_product_line_view_search"/>
    </record>

    <menuitem id="menu_geofolia_import_product_lines"
              name="Product Lines"
              parent="ter_analytic_geofolia.menu_geofolia_import"
              action="action_geofolia_import_product_line"
              groups="group_geofolia_import"
              sequence="16"/>
</odoo>
