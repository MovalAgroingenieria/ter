<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="fsm_location_form_view" model="ir.ui.view">
        <field name="name">fsm.location.form.inherit.geofolia</field>
        <field name="model">fsm.location</field>
        <field name="inherit_id" ref="fieldservice.fsm_location_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='others']" position="after">
                <page string="Geofolia" name="geofolia">
                    <group>
                        <group>
                            <field name="geofolia_external_id" string="Geofolia ID" readonly="1"/>
                        </group>
                        <group>
                            <field name="ter_use_unit_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="fsm_location_list_view" model="ir.ui.view">
        <field name="name">fsm.location.tree.inherit.geofolia</field>
        <field name="model">fsm.location</field>
        <field name="inherit_id" ref="fieldservice.fsm_location_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="geofolia_external_id" string="Geofolia ID" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="fsm_location_search_view" model="ir.ui.view">
        <field name="name">fsm.location.search.inherit.geofolia</field>
        <field name="model">fsm.location</field>
        <field name="inherit_id" ref="fieldservice.fsm_location_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="geofolia_external_id" string="Geofolia ID"/>
                <filter name="filter_from_geofolia" string="From Geofolia"
                        domain="[('geofolia_external_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
