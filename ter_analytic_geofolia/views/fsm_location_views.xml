<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="fsm_location_form_view_geofolia" model="ir.ui.view">
        <field name="name">fsm.location.form.geofolia</field>
        <field name="model">fsm.location</field>
        <field name="inherit_id" ref="fieldservice.fsm_location_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='main-right']" position="inside">
                <field name="geofolia_external_id" string="Geofolia ID"/>
                <field name="ter_use_unit_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="fsm_location_tree_view_geofolia" model="ir.ui.view">
        <field name="name">fsm.location.tree.geofolia</field>
        <field name="model">fsm.location</field>
        <field name="inherit_id" ref="fieldservice.fsm_location_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="geofolia_external_id" string="Geofolia ID" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="fsm_location_search_view_geofolia" model="ir.ui.view">
        <field name="name">fsm.location.search.geofolia</field>
        <field name="model">fsm.location</field>
        <field name="inherit_id" ref="fieldservice.fsm_location_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="geofolia_external_id" string="Geofolia ID"/>
                <filter name="filter_from_geofolia" string="From Geofolia"
                        domain="[('geofolia_external_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
