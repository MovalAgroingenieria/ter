<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ter_sigpac_view_form" model="ir.ui.view">
        <field name="name">l10n_es_territory_sigpac.ter_sigpac_view_form</field>
        <field name="model">ter.sigpac</field>
        <field name="arch" type="xml">
            <form duplicate="false" create="false" delete="false" edit="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_sigpac_viewer"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-map-marker"
                                title="SIGPAC Viewer">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">SIGPAC</span>
                                <span class="o_stat_text">Viewer</span>
                            </div>
                        </button>

                        <button name="action_get_parcels"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-ter-parcel"
                                invisible="number_of_sigpaclinks == 0">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value">
                                    <field name="number_of_sigpaclinks"/>
                                </span>
                                <span class="o_stat_text">Parcels</span>
                            </div>
                        </button>
                    </div>

                    <group name="master_data">
                        <group name="master_data_left">
                            <div name="section_sigpac_identification" colspan="2" class="text-center mb-4">
                                <p class="border p-2 fw-bold" style="width:100%">IDENTIFICATION</p>
                            </div>
                            <field name="dn_oid"/>
                            <field name="provincia"/>
                            <field name="municipio"/>
                            <field name="agregado"/>
                            <field name="zona"/>
                            <field name="poligono"/>
                            <field name="parcela"/>
                            <field name="recinto"/>
                        </group>

                        <group name="master_data_right">
                            <div name="section_sigpac_data" colspan="2" class="text-center mb-4">
                                <p class="border p-2 fw-bold" style="width:100%">SIGPAC DATA</p>
                            </div>
                            <field name="uso_sigpac"/>
                            <field name="coef_rega"/>
                            <field name="dn_surface_ha"/>
                            <field name="dn_perim"/>
                            <field name="pend_media_porc"/>
                            <field name="coef_admis"/>
                            <field name="incidencia"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ter_sigpac_view_tree" model="ir.ui.view">
        <field name="name">l10n_es_territory_sigpac.ter_sigpac_view_list</field>
        <field name="model">ter.sigpac</field>
        <field name="arch" type="xml">
            <list class="o_l10n_es_territory_sigpac_sigpac_view_tree" create="false" delete="false">
                <field name="name"
                       string="Code: prov. - munic. - aggreg. - zone - polyg. - parcel - enclos."/>
                <button name="action_sigpac_viewer"
                        type="object"
                        icon="fa-map-marker"
                        title="SIGPAC Viewer"/>
                <field name="dn_oid" string="SIGPAC Id."/>
                <field name="dn_surface_ha"/>
                <field name="pend_media_porc" string="Slope %"/>
                <field name="coef_rega"/>
                <field name="uso_sigpac"/>
            </list>
        </field>
    </record>

    <record id="ter_sigpac_view_search" model="ir.ui.view">
        <field name="name">l10n_es_territory_sigpac.ter_sigpac_view_search</field>
        <field name="model">ter.sigpac</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Code"/>
                <field name="dn_oid" string="SIGPAC Id."/>
                <field name="uso_sigpac"/>
                <group expand="0" string="Group By">
                    <filter string="Land Use"
                            name="grouped_uso_sigpac"
                            context="{'group_by': 'uso_sigpac'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ter_sigpac_view_pivot" model="ir.ui.view">
        <field name="name">l10n_es_territory_sigpac.ter_sigpac_view_pivot</field>
        <field name="model">ter.sigpac</field>
        <field name="arch" type="xml">
            <pivot string="Area (ha)">
                <field name="uso_sigpac" type="row"/>
                <field name="dn_surface_ha" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="ter_sigpac_view_graph" model="ir.ui.view">
        <field name="name">l10n_es_territory_sigpac.ter_sigpac_view_graph</field>
        <field name="model">ter.sigpac</field>
        <field name="arch" type="xml">
            <graph string="Area (ha)">
                <field name="uso_sigpac" type="row"/>
                <field name="dn_surface_ha" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="ter_sigpac_action" model="ir.actions.act_window">
        <field name="name">SIGPAC enclosures</field>
        <field name="res_model">ter.sigpac</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="view_ids"
               eval="[(5, 0),
                      (0, 0, {'view_mode': 'list', 'view_id': ref('ter_sigpac_view_tree')}),
                      (0, 0, {'view_mode': 'form', 'view_id': ref('ter_sigpac_view_form')}),
                      (0, 0, {'view_mode': 'pivot', 'view_id': ref('ter_sigpac_view_pivot')}),
                      (0, 0, {'view_mode': 'graph', 'view_id': ref('ter_sigpac_view_graph')})]"/>
        <field name="search_view_id" ref="ter_sigpac_view_search"/>
    </record>

    <menuitem id="sigpac_menu"
              name="SIGPAC enclosures"
              parent="base_ter.menu_territory"
              sequence="30"
              action="ter_sigpac_action"
              groups="base_ter.group_ter_user"/>

</odoo>
