<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_ter_sigpac" model="ir.actions.act_window">
        <field name="name">SIGPAC Enclosures</field>
        <field name="res_model">ter.sigpac</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_ids"
               eval="[(5, 0),
                      (0, 0, {'view_mode': 'pivot', 'view_id': ref('l10n_es_territory_sigpac.ter_sigpac_view_pivot')}),
                      (0, 0, {'view_mode': 'graph', 'view_id': ref('l10n_es_territory_sigpac.ter_sigpac_view_graph')}),
                      (0, 0, {'view_mode': 'list', 'view_id': ref('l10n_es_territory_sigpac.ter_sigpac_view_tree')})]"/>
        <field name="search_view_id" ref="ter_sigpac_view_search"/>
    </record>

    <menuitem id="menu_informes_sigpac"
              name="SIGPAC Enclosures"
              parent="base_ter.menu_informes"
              action="action_report_ter_sigpac"
              sequence="40"/>
</odoo>
