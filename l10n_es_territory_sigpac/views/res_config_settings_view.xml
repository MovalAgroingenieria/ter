<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">l10n_es_territory_sigpac.res_config_settings_view_form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="30"/>
        <field name="inherit_id" ref="base_ter.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='base_ter']" position="inside">
                <block title="SIGPAC" name="sigpac_settings">
                    <setting id="sigpac_path"
                             string="SIGPAC shapefiles path"
                             help="Path of the official shapefiles of SIGPAC, in the server.">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="sigpac_path" style="width: 300px;"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="sigpac_names"
                             string="SIGPAC shapefiles names"
                             help="Names of the official shapefiles of SIGPAC (comma-separated).">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="sigpac_names" style="width: 300px;"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="wms_sigpac_url"
                             string="WMS SIGPAC URL"
                             help="URL of the WMS service used to obtain SIGPAC images.">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="wms_sigpac_url" style="width: 100%;"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="wms_sigpac_layer"
                             string="WMS SIGPAC layer"
                             help="WMS service layer used to obtain SIGPAC images.">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="wms_sigpac_layer" style="width: 100%;"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="irrigation_model_type"
                             string="Irrigation model type"
                             help="Default irrigation model type used in SIGPAC views (company-specific).">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="irrigation_model_type" style="width: 120px;"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="url_gis_viewer_epsg_code"
                             string="URL Gis Viewer EPSG CODE"
                              >
                        <div class="content-group">
                            <div class="mt16">
                                <field name="url_gis_viewer_epsg_code" style="width: 120px;"/>
                            </div>
                        </div>
                    </setting>


                    <setting id="sigpac_minimum_intersection_percentage"
                             string="Minimum intersection (%)"
                             help="Minimum intersection percentage allowed for parcels and SIGPAC enclosures.">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="sigpac_minimum_intersection_percentage" style="width: 90px;"/>
                                <span class="oe_inline">%</span>
                            </div>
                        </div>
                    </setting>

                    <setting id="sigpac_viewer_url"
                             string="SIGPAC viewer URL template"
                             help="URL template for SIGPAC viewer (Jinja2).">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="sigpac_viewer_url" style="width: 100%;"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="python_venv_url"
                             string="Python interpreter"
                             help="Python interpreter path used to run the SIGPAC import helper.">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="python_venv_url" style="width: 100%;"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="action_load_sigpac"
                             string="Load SIGPAC enclosures"
                             help="Imports the SIGPAC enclosures into the GIS tables and refreshes intersections.">
                        <div class="content-group">
                            <div class="mt16">
                                <button type="object"
                                        name="action_load_sigpac"
                                        string="Load SIGPAC enclosures"
                                        icon="fa-download"
                                        class="oe_inline oe_link"/>
                            </div>
                            <div class="text-muted mt16">
                                IMPORTANT: If the 'Minimum intersection' parameter is changed, it is necessary to reload the SIGPAC enclosures.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
