<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Form: add Analytic Account in Identification section -->
    <record id="view_ter_unit_form_analytic" model="ir.ui.view">
        <field name="name">ter.unit.form.analytic</field>
        <field name="model">ter.use_unit</field>
        <field name="inherit_id" ref="base_ter.ter_use_unit_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_range_use_type_id']" position="after">
                <field name="account_id" options="{'no_create': True}"
                       readonly="state == 'validated'"/>
            </xpath>
        </field>
    </record>

    <!-- List: add Analytic Account column -->
    <record id="view_ter_unit_list_analytic" model="ir.ui.view">
        <field name="name">ter.unit.list.analytic</field>
        <field name="model">ter.use_unit</field>
        <field name="inherit_id" ref="base_ter.ter_use_unit_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="account_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Search: add Analytic Account in search and group by -->
    <record id="view_ter_unit_filter_analytic" model="ir.ui.view">
        <field name="name">ter.unit.search.analytic</field>
        <field name="model">ter.use_unit</field>
        <field name="inherit_id" ref="base_ter.ter_use_unit_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='partner_id']" position="after">
                <field name="account_id"/>
            </xpath>
            <xpath expr="//filter[@name='group_by_municipality']" position="after">
                <filter name="group_by_account" string="Analytic Account"
                        context="{'group_by': 'account_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Kanban: show Analytic Account on card -->
    <record id="view_ter_unit_kanban_analytic" model="ir.ui.view">
        <field name="name">ter.unit.kanban.analytic</field>
        <field name="model">ter.use_unit</field>
        <field name="inherit_id" ref="base_ter.ter_use_unit_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attribute_value_ids']" position="before">
                <field name="account_id"/>
            </xpath>
            <xpath expr="//templates//field[@name='use_type_id']" position="after">
                <field name="account_id"/>
            </xpath>
        </field>
    </record>

    <!-- Pivot: add Analytic Account as row -->
    <record id="view_ter_unit_pivot_analytic" model="ir.ui.view">
        <field name="name">ter.unit.pivot.analytic</field>
        <field name="model">ter.use_unit</field>
        <field name="inherit_id" ref="base_ter.ter_use_unit_view_pivot"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='municipality_id']" position="after">
                <field name="account_id" type="row"/>
            </xpath>
        </field>
    </record>

</odoo>
