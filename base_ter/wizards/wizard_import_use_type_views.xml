<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="wizard_import_use_type_view_form" model="ir.ui.view">
        <field name="name">wizard.import.use.type.form</field>
        <field name="model">wizard.import.use.type</field>
        <field name="arch" type="xml">
            <form string="Import Use Types">
                <sheet>
                    <div invisible="state != 'confirm'">
                        <p>
                            This will import the standard use type catalog
                            (farming, livestock, forestry …) from the bundled
                            data file. Existing records with the same external
                            ID will be kept unchanged.
                        </p>
                        <p>
                            Translations (Spanish and Catalan) are loaded
                            automatically from separate data files.
                        </p>
                        <p class="text-muted">
                            You can safely run this wizard again — it will
                            refresh translations without duplicating records.
                        </p>
                    </div>
                    <div invisible="state != 'done'">
                        <field name="state" invisible="1"/>
                        <field name="result_message" nolabel="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_import" type="object" string="Import"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_import_use_type_action" model="ir.actions.act_window">
        <field name="name">Import Use Types</field>
        <field name="res_model">wizard.import.use.type</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
