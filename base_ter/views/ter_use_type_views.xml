<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_use_type_kanban" model="ir.ui.view">
        <field name="name">ter.use_type.kanban</field>
        <field name="model">ter.use_type</field>
        <field name="arch" type="xml">
            <kanban default_group_by="parent_id"
                    group_create="false"
                    class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="complete_name"/>
                <field name="color"/>
                <field name="unit_count"/>
                <field name="parcel_count"/>
                <field name="date_range_count"/>
                <field name="parent_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_color_#{record.color.raw_value or 0}">
                            <div class="oe_kanban_content">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted">
                                    <field name="complete_name"/>
                                </div>
                                <div class="mt-2 d-flex justify-content-between">
                                    <span>
                                        <field name="unit_count"/> Units
                                    </span>
                                    <span>
                                        <field name="parcel_count"/> Parcels
                                    </span>
                                    <span>
                                        <field name="date_range_count"/> Date Ranges
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_use_type_list" model="ir.ui.view">
        <field name="name">ter.use_type.list</field>
        <field name="model">ter.use_type</field>
        <field name="arch" type="xml">
            <list string="Use Types" default_order="parent_path, sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_use_type_form" model="ir.ui.view">
        <field name="name">ter.use_type.form</field>
        <field name="model">ter.use_type</field>
        <field name="arch" type="xml">
            <form string="Use Type">
                <header>
                    <button name="action_view_descendants" type="object"
                            string="Descendants" class="oe_highlight"
                    />
                    <button name="action_view_ancestors" type="object"
                            string="Ancestors"
                    />
                    <field name="active" widget="boolean_toggle"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="unit_count" invisible="1"/>
                        <field name="parcel_count" invisible="1"/>
                        <field name="date_range_count" invisible="1"/>
                        <button name="action_show_units" type="object"
                                class="oe_stat_button" icon="fa-sitemap">
                            <field name="unit_count" string="Units" widget="statinfo"/>
                        </button>
                        <button name="action_show_parcels" type="object"
                                class="oe_stat_button" icon="fa-ter-parcel">
                            <field name="parcel_count" string="Parcels" widget="statinfo"/>
                        </button>
                        <button name="action_show_date_ranges" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="date_range_count" string="Date Ranges" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Industrial vehicle"/>
                        </h1>
                        <div class="text-muted">
                            <field name="complete_name" readonly="1"/>
                        </div>
                    </div>

                    <group>
                        <group>
                            <field name="parent_id" options="{'no_create': True}"/>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Children">
                            <field name="child_ids" context="{'default_parent_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="active" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attributes">
                            <field name="attribute_ids" context="{'default_use_type_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="required"/>
                                    <field name="value_ids" widget="many2many_tags"
                                           context="{'default_attribute_id': id}"
                                           options="{'no_create_edit': True}"/>
                                </list>
                                <form string="Attribute">
                                    <sheet>
                                        <group>
                                            <field name="sequence"/>
                                            <field name="name"/>
                                            <field name="required"/>
                                        </group>

                                        <group string="Allowed Values">
                                            <field name="value_ids" context="{'default_attribute_id': id}">
                                                <list editable="bottom">
                                                    <field name="sequence" widget="handle"/>
                                                    <field name="name"/>
                                                </list>
                                            </field>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_use_type_search" model="ir.ui.view">
        <field name="name">ter.use_type.search</field>
        <field name="model">ter.use_type</field>
        <field name="arch" type="xml">
            <search string="Search Use Types">
                <field name="name" string="Name"/>
                <field name="complete_name" string="Path"/>

                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>

                <separator/>

                <field name="parent_id"/>
                <filter string="Top level" name="top_level" domain="[('parent_id','=',False)]"/>

                <group expand="0" string="Group By">
                    <filter string="Parent" name="group_by_parent" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_use_type" model="ir.actions.act_window">
        <field name="name">Use Types</field>
        <field name="res_model">ter.use_type</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[(5, 0),
              (0, 0, {'view_mode': 'list', 'view_id': ref('view_use_type_list')}),
              (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_use_type_kanban')}),
              (0, 0, {'view_mode': 'form', 'view_id': ref('view_use_type_form')})]"/>
        <field name="search_view_id" ref="view_use_type_search"/>
        <field name="context">{'search_default_group_by_parent': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first use type
            </p>
            <p>
                Use Types can be nested in a list. You can search by full path and browse children easily.
            </p>
        </field>
    </record>

    <menuitem id="menu_use_type" name="Use Types" parent="base_ter.menu_configuration_general"
              action="action_use_type" sequence="10"/>
</odoo>
