<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="c" model="ir.ui.view">
        <field name="name">ter.unit.list</field>
        <field name="model">ter.unit</field>
        <field name="arch" type="xml">
            <list string="Analytic Items" multi_edit="1" js_class="analytic_list">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="parcel_id"/>
                <field name="area_official"/>
                <field name="date_range_id"/>
                <field name="account_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>

    <record id="view_ter_unit_filter" model="ir.ui.view">
        <field name="name">ter.unit.select</field>
        <field name="model">ter.unit</field>
        <field name="arch" type="xml">
            <search string="Search Analytic Lines">
                <field name="name"/>
                <field name="date_range_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="is_current"/>
                <separator/>
                <filter name="filter_is_current" string="In Range" domain="[('is_current', '=', True)]"/>
                <filter name="filter_not_current" string="Not in Range" domain="[('is_current', '=', False)]"/>
                <separator/>
                <filter name="month" string="Date" date="date_start"/>
                <group string="Group By..." expand="0" name="groupby">
                    <separator/>
                    <filter string="Start Date" name="group_date_start" context="{'group_by': 'date_start'}"/>
                    <filter string="End Date" name="group_date_end" context="{'group_by': 'date_end'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="view_ter_unit_form" model="ir.ui.view">
        <field name="name">ter.unit.form</field>
        <field name="model">ter.unit</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Ter Unit">
                <sheet>
                    <group>
                        <group name="analytic_item" string="Description">
                            <field name="name" readonly="1"/>
                            <field name="description"/>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="account_id" options='{"no_open": True, "no_create": True}'/>
                        </group>
                        <group string="Location">
                            <field name="parcel_id" options='{"no_open": True, "no_create": True}'/>
                            <field name="partner_id" readonly="1"/>
                            <field name="geom_ewkt" placeholder="SRID=25830;POLYGON((...))" widget="text"/>
                            <field name="area_official"/>
                            <field name="area_official_m2"/>
                        </group>
                        <group string="Date Ranges Ter">
                            <field name="date_range_id" options='{"no_open": True, "no_create": True}'/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="is_current" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_range_use_type_id" invisible="1"/>
                            <field name="use_type_id"
                                   required="1"
                                   domain="[('id', 'child_of', date_range_use_type_id)]"
                            />
                        </group>
                        <notebook>
                            <page string="Attributes">
                                <field name="attribute_value_ids" create="0" delete="0">
                                    <list editable="bottom">
                                        <field name="attribute_id" readonly="1" force_save="1"/>
                                        <field name="required" readonly="1" force_save="1"/>
                                        <field name="value_id"
                                               domain="[('attribute_id', '=', attribute_id)]"
                                               options="{'no_create': True, 'no_create_edit': True}"/>
                                    </list>
                                </field>

                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="ter_unit_action_entrie">
        <field name="name">Ter Unit</field>
        <field name="res_model">ter.unit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No activity yet
            </p>
        </field>
    </record>

    <menuitem id="ter_unit_action_entrie_menu"
              parent="base_ter.menu_territory"
              action="ter_unit_action_entrie"
              sequence="101"/>


</odoo>
