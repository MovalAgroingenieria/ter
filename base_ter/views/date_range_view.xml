<odoo>
    <record id="view_date_range_list" model="ir.ui.view">
        <field name="name">date.range.list.ext</field>
        <field name="model">date.range</field>
        <field name="priority" eval="99"/>
        <field name="inherit_id" ref="date_range.view_date_range_list"/>
        <field name="arch" type="xml">

            <field name="type_id" position="before">
                <field name="is_unit_use_type" invisible="'default_is_unit_use_type' in context"/>
                <field name="use_type_id" invisible="not is_unit_use_type" required="is_unit_use_type" options="{'no_open': True, 'no_create': True}"/>
            </field>
            <xpath expr="//list" position="replace">
                <list string="Date Ranges">
                    <field name="name"/>
                    <field name="is_unit_use_type" invisible="'default_is_unit_use_type' in context"/>
                    <field name="use_type_id" invisible="not is_unit_use_type" required="is_unit_use_type" options="{'no_open': True, 'no_create': True}"/>
                    <field name="type_id"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="company_id" column_invisible="1"/>
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </xpath>
            <field name="type_id" position="attributes">
                <attribute name="domain">[('is_unit_use_type', '=', is_unit_use_type)]</attribute>
            </field>
        </field>
    </record>

    <record id="view_date_range_kanban" model="ir.ui.view">
        <field name="name">date.range.kanban.ter</field>
        <field name="model">date.range</field>
        <field name="arch" type="xml">
            <kanban default_group_by="use_type_id"
                    group_create="false"
                    class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="type_id"/>
                <field name="use_type_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="color"/>
                <field name="unit_count"/>
                <field name="parcel_count"/>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_color_#{record.color.raw_value or 0}">
                            <div class="oe_kanban_content">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted">
                                    <field name="use_type_id"/>
                                </div>
                                <div class="mt-1">
                                    <field name="date_start"/> — <field name="date_end"/>
                                </div>
                                <div class="mt-2 d-flex justify-content-between">
                                    <span>
                                        <field name="unit_count"/> Units
                                    </span>
                                    <span>
                                        <field name="parcel_count"/> Parcels
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_date_range_form_view" model="ir.ui.view">
        <field name="name">date.range.form.ext</field>
        <field name="model">date.range</field>
        <field name="inherit_id" ref="date_range.view_date_range_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form/group" position="before">
                <field name="unit_count" invisible="1"/>
                <field name="parcel_count" invisible="1"/>
                <div class="oe_button_box" name="button_box">
                    <button name="action_show_units" type="object"
                            class="oe_stat_button" icon="fa-sitemap"
                            invisible="not is_unit_use_type">
                        <field name="unit_count" string="Units" widget="statinfo"/>
                    </button>
                    <button name="action_show_parcels" type="object"
                            class="oe_stat_button" icon="fa-ter-parcel"
                            invisible="not is_unit_use_type">
                        <field name="parcel_count" string="Parcels" widget="statinfo"/>
                    </button>
                    <button name="action_show_use_type" type="object"
                            class="oe_stat_button" icon="fa-leaf"
                            invisible="not is_unit_use_type or not use_type_id">
                        <div class="o_stat_info">
                            <span class="o_stat_value"/>
                            <span class="o_stat_text">Use Type</span>
                        </div>
                    </button>
                </div>
            </xpath>
            <field name="type_id" position="before">
                <field name="is_unit_use_type" invisible="'default_is_unit_use_type' in context"/>
                <field name="use_type_id" string="Territorial use type"
                       invisible="not is_unit_use_type"
                       required="is_unit_use_type"
                       options="{'no_open': True, 'no_create': True}"/>
            </field>
            <field name="type_id" position="attributes">
                <attribute name="domain">[('is_unit_use_type', '=', is_unit_use_type)]</attribute>
            </field>
            <xpath expr="//form" position="inside">
                <notebook invisible="not is_unit_use_type">
                    <page string="Notes" name="notes">
                        <field name="note" placeholder="Internal notes..."/>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_date_range_search" model="ir.ui.view">
        <field name="name">date.range.search.ext</field>
        <field name="model">date.range</field>
        <field name="inherit_id" ref="date_range.view_date_range_search"/>
        <field name="arch" type="xml">
            <filter name="date_end" position="after">
                <filter name="type"/>
                <separator/>
            </filter>
        </field>
    </record>


    <record id="view_date_range_type_list" model="ir.ui.view">
        <field name="name">date.range.type.list.ext</field>
        <field name="model">date.range.type</field>
        <field name="inherit_id" ref="date_range.view_date_range_type_list"/>
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="is_unit_use_type" invisible="'default_is_unit_use_type' in context"/>
            </field>
        </field>
    </record>

    <record id="view_date_range_type_form_view" model="ir.ui.view">
        <field name="name">date.range.type.form.ext</field>
        <field name="model">date.range.type</field>
        <field name="inherit_id" ref="date_range.view_date_range_type_form_view"/>
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="is_unit_use_type" invisible="'default_is_unit_use_type' in context"/>
            </field>
        </field>
    </record>

    <record id="view_date_range_type_search" model="ir.ui.view">
        <field name="name">date.range.type.search.ext</field>
        <field name="model">date.range.type</field>
        <field name="inherit_id" ref="date_range.view_date_range_type_search"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="is_unit_use_type"/>
            </field>
        </field>
    </record>

    <record id="date_range_action" model="ir.actions.act_window">
        <field name="name">Date Ranges Ter</field>
        <field name="res_model">date.range</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="view_ids" eval="[(5, 0),
              (0, 0, {'view_mode': 'list', 'view_id': ref('view_date_range_list')}),
              (0, 0, {'view_mode': 'form', 'view_id': ref('view_date_range_form_view')}),
              (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_date_range_kanban')}),
              ]"/>
        <field name="domain">[('is_unit_use_type', '=', True)]</field>
        <field name="context">{'default_is_unit_use_type': True}</field>
    </record>
    <record id="date_range_type_action" model="ir.actions.act_window">
        <field name="name">Date Ranges Types Ter</field>
        <field name="res_model">date.range.type</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_date_range_type_list" />
        <field name="domain">[('is_unit_use_type', '=', True)]</field>
        <field name="context">{'default_is_unit_use_type': True}</field>
    </record>

    <menuitem id="menu_date_range_action"
            action="date_range_action"
            parent="base_ter.menu_configuration_dates"
            sequence="10"
    />
    <menuitem id="menu_date_range_type_action"
            action="date_range_type_action"
            parent="base_ter.menu_configuration_dates"
            sequence="20"
    />
</odoo>
