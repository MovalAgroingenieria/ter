<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.base_ter</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="base_gis_viewer.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="base_ter" string="Territory" data-string="Territory">

                    <block title="General" name="base_ter_general">
                        <setting id="base_ter_area_unit_is_ha"
                                 string="Area unit is hectare"
                                 help="If checked, the area unit will be the ha; otherwise you can choose another unit of area.">
                            <field name="area_unit_is_ha"/>
                        </setting>

                        <setting id="base_ter_area_unit_name"
                                 string="Alternative area unit name"
                                 help="If the area unit is not the ha, name of the alternative area unit."
                                 invisible="area_unit_is_ha">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="area_unit_name" style="width: 90px;"/>
                                </div>
                            </div>
                        </setting>

                        <setting id="base_ter_area_unit_value_in_ha"
                                 string="Alternative unit equivalence (ha)"
                                 help="Equivalence, in ha, of the chosen area unit."
                                 invisible="area_unit_is_ha">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="area_unit_value_in_ha" style="width: 90px;"/>
                                    <span class="oe_inline">ha</span>
                                </div>
                            </div>
                        </setting>

                        <setting id="base_ter_ter_unit_sequence_id_args" string="Ter-unit sequence">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="ter_unit_sequence_id" style="width: 100%;"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Warnings" name="base_ter_warnings">
                        <setting id="base_ter_warning_diff_areas"
                                 string="Maximum GIS area difference (%)"
                                 help="Percentage (of the official area of a parcel) designated as the maximum allowable threshold for the difference between this official area and the GIS area (if zero, no warning will be displayed).">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="warning_diff_areas" style="width: 90px;"/>
                                    <span class="oe_inline">%</span>
                                </div>
                            </div>
                        </setting>

                        <setting id="base_ter_same_parcelmanager_propertyowner"
                                 string="Force parcel manager to be property owner"
                                 help="If enabled, any parcel associated with a property that has an owner must have that owner as its manager.">
                            <field name="same_parcelmanager_propertyowner"/>
                        </setting>
                    </block>

                </app>
            </xpath>
            <xpath expr="//app[@name='base_gis_viewer']" position="inside">
                <block title="Territory Vector Layers" name="base_ter_vector_layers">
                    <setting id="base_ter_aerial_image_wmsvec_url"
                             string="Vector WMS URL"
                             help="URL of the WMS service used to obtain the vectorial image of the parcels.">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="aerial_image_wmsvec_url" style="width: 100%;"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="base_ter_aerial_image_wmsvec_parcel_name"
                             string="Parcel vector layer"
                             help="WMS service layer used to obtain the images of the parcels (vectorial elements).">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="aerial_image_wmsvec_parcel_name" style="width: 100%;"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="base_ter_aerial_image_wmsvec_parcel_filter"
                             string="Only central parcel"
                             help="If checked, only the central parcel will be displayed; otherwise, all parcels will be displayed.">
                        <field name="aerial_image_wmsvec_parcel_filter"/>
                    </setting>
                    <setting id="base_ter_aerial_image_wmsvec_property_name"
                             string="Property vector layer"
                             help="WMS service layer used to obtain the images of the properties (vectorial elements).">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="aerial_image_wmsvec_property_name" style="width: 100%;"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="base_ter_aerial_image_wmsvec_property_filter"
                             string="Only central property"
                             help="If checked, only the central property will be displayed; otherwise, all properties will be displayed.">
                        <field name="aerial_image_wmsvec_property_filter"/>
                    </setting>
                    <setting id="base_ter_aerial_image_wmsvec_unit_name"
                             string="Unit vector layer"
                             help="WMS service layer used to obtain the images of the units (vectorial elements).">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="aerial_image_wmsvec_unit_name" style="width: 100%;"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="base_ter_aerial_image_wmsvec_unit_filter"
                             string="Only central unit"
                             help="If checked, only the central unit will be displayed; otherwise, all units will be displayed.">
                        <field name="aerial_image_wmsvec_unit_filter"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'base_ter'}</field>
    </record>

    <menuitem id="res_config_settings_menu"
        parent="menu_configuration"
        action="res_config_settings_action"
        sequence="10"
        groups="base.group_system"/>

</odoo>
