<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="ter_use_type_attribute_view_form" model="ir.ui.view">
        <field name="name">ter.use_type.attribute.form</field>
        <field name="model">ter.use_type.attribute</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="use_type_id"/>
                        <field name="required"/>
                        <field name="sequence"/>
                    </group>

                    <group string="Allowed Values">
                        <field name="value_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
