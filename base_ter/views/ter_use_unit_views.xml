<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ter_unit_attribute_value_list" model="ir.ui.view">
        <field name="name">ter.unit.attribute.value.list</field>
        <field name="model">ter.unit.attribute.value</field>
        <field name="arch" type="xml">
            <list string="Attribute Values" editable="bottom">
                <field name="attribute_id"/>
                <field name="value_id"/>
                <field name="color" widget="color_picker"/>
                <field name="required" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ter_unit_attribute_value_form" model="ir.ui.view">
        <field name="name">ter.unit.attribute.value.form</field>
        <field name="model">ter.unit.attribute.value</field>
        <field name="arch" type="xml">
            <form string="Attribute Value">
                <sheet>
                    <group>
                        <group>
                            <field name="unit_id" readonly="1"/>
                            <field name="attribute_id" readonly="1"/>
                            <field name="value_id"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ter_unit_filter" model="ir.ui.view">
        <field name="name">ter.unit.search</field>
        <field name="model">ter.use_unit</field>
        <field name="arch" type="xml">
            <search string="Search Territorial Units">
                <field name="alphanum_code"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_range_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="is_current"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_validated" string="Validated" domain="[('state', '=', 'validated')]"/>
                <separator/>
                <filter name="filter_validity_not_started" string="Not Started" domain="[('validity_state', '=', 'not_started')]"/>
                <filter name="filter_validity_in_range" string="In Range" domain="[('validity_state', '=', 'in_range')]"/>
                <filter name="filter_validity_out_of_range" string="Out of Range" domain="[('validity_state', '=', 'out_of_range')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_use_type" string="Type" context="{'group_by': 'use_type_id'}"/>
                    <filter name="group_by_partner" string="Holder" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_farm_property" string="Farm/Property" context="{'group_by': 'farm_property_id'}"/>
                    <filter name="group_by_date_range" string="Date Range" context="{'group_by': 'date_range_id'}"/>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_validity_state" string="Validity State" context="{'group_by': 'validity_state'}"/>
                    <filter name="group_by_municipality" string="Municipality" context="{'group_by': 'municipality_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ter_unit_list" model="ir.ui.view">
        <field name="name">ter.unit.list</field>
        <field name="model">ter.use_unit</field>
        <field name="arch" type="xml">
            <list string="Territorial Units" default_order="name">
                <field name="alphanum_code"/>
                <field name="name"/>
                <field name="use_type_id" string="Type"/>
                <field name="attribute_value_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="partner_id"/>
                <field name="farm_property_id"/>
                <field name="date_range_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
                <field name="validity_state"/>
                <field name="area_gis_ha"/>
                <field name="area_official"/>
            </list>
        </field>
    </record>

    <record id="view_ter_unit_kanban" model="ir.ui.view">
        <field name="name">ter.unit.kanban</field>
        <field name="model">ter.use_unit</field>
        <field name="arch" type="xml">
            <kanban class="o_terunit_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="alphanum_code"/>
                <field name="partner_id"/>
                <field name="use_type_id"/>
                <field name="state"/>
                <field name="validity_state"/>
                <field name="area_gis_ha"/>
                <field name="parcel_aerial_image_shown_256"/>
                <field name="attribute_value_ids"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_terunit_kanban_image d-flex justify-content-center">
                                <t t-if="record.parcel_aerial_image_shown_256 and record.parcel_aerial_image_shown_256.raw_value">
                                    <img t-att-src="kanban_image('ter.unit', 'parcel_aerial_image_shown_256', record.id.raw_value)"
                                         alt="ter_unit_256"
                                         style="border-color:#696969;border-width:1px;border-style:solid"/>
                                </t>
                                <t t-else="">
                                    <img t-att-src="'/base_ter/static/img/avatar_terparcel.png'"
                                         width="150"
                                         alt="ter_unit_avatar"
                                         style="margin-top:30px"/>
                                </t>
                            </div>
                            <div class="oe_kanban_details mt-2">
                                <strong class="o_kanban_record_title">
                                    <field name="alphanum_code"/>
                                </strong>
                                <div class="text-muted">
                                    <field name="name"/>
                                </div>
                                <div class="mt-2">
                                    <field name="partner_id"/>
                                    <field name="use_type_id"/>
                                    <field  name="attribute_value_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                                    <span class="badge text-bg-secondary ms-1"><field name="state"/></span>
                                    <span class="badge text-bg-info ms-1"><field name="validity_state"/></span>
                                </div>
                                <div class="mt-1">
                                    <field name="area_gis_ha"/> ha
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ter_unit_pivot" model="ir.ui.view">
        <field name="name">ter.unit.pivot</field>
        <field name="model">ter.use_unit</field>
        <field name="arch" type="xml">
            <pivot string="Territorial Units" display_quantity="true">
                <field name="use_type_id" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="municipality_id" type="row"/>
                <field name="state" type="col"/>
                <field name="validity_state" type="col"/>
                <field name="date_range_id" type="col"/>
                <field name="area_gis_ha" type="measure"/>
                <field name="area_official" type="measure"/>
                <field name="area_parcels" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ter_unit_form" model="ir.ui.view">
        <field name="name">ter.unit.form</field>
        <field name="model">ter.use_unit</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Territorial Unit">
                <header>
                    <button name="action_validate" type="object" string="Validate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_set_to_draft" type="object" string="Set to Draft"
                            class="btn-secondary" invisible="state != 'validated'"/>
                    <button name="action_gis_viewer" type="object" string="GIS Viewer"
                            class="btn-link" invisible="not parcel_id"/>
                    <button name="action_regenerate_image" type="object" string="Regenerate Image"
                            class="btn-link" invisible="not parcel_id"/>
                    <button name="toggle_active" type="object" string="Archive"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">

                    </div>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated"/>
                    <group>
                        <group string="Identification">
                            <field name="alphanum_code"/>
                            <field name="name" readonly="state == 'validated'"/>
                            <field name="use_type_id" string="Type"
                                   domain="[('id', 'child_of', date_range_use_type_id)]"
                                   options="{'no_open': True, 'no_create': True}"
                                   readonly="state == 'validated'"/>
                            <field name="date_range_use_type_id" invisible="1"/>
                        </group>
                        <group string="Location">
                            <field name="parcel_id" string="Main Parcel"
                                   options="{'no_open': True, 'no_create': True}"
                                   readonly="state == 'validated'"/>
                            <field name="farm_property_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group string="Dates">
                            <field name="date_range_id"
                                   domain="[('is_unit_use_type', '=', True)]"
                                   options="{'no_open': True, 'no_create': True}"
                                   readonly="state == 'validated'"/>
                            <field name="date_start" readonly="state == 'validated'"/>
                            <field name="date_end" readonly="state == 'validated'"/>
                            <field name="validity_state" readonly="1"/>
                        </group>
                    </group>
                    <group string="Areas">
                        <group>
                            <field name="area_gis_ha"/>
                            <field name="area_official"/>
                        </group>
                        <group>
                            <field name="area_parcels"/>
                            <field name="area_unit_name" invisible="1"/>
                        </group>
                    </group>

                    <group string="GIS">
                        <group>
                            <div class="text-center mb-3">
                                <field name="parcel_image_1920" widget="image"
                                       options="{'preview_image': 'parcel_aerial_image_shown_256', 'zoom': true}"/>
                                <div class="mt-2">
                                    <button name="action_gis_preview" type="object"
                                            string="GIS Preview" class="oe_highlight"
                                            invisible="not parcel_id"/>
                                </div>
                            </div>
                            <field name="geom_ewkt" placeholder="SRID=25830;POLYGON((...))"
                                   widget="text" readonly="state == 'validated'" invisible="1"/>
                        </group>
                        <group>
                            <field name="municipality_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                        <page string="Attributes" name="attributes">
                            <field name="attribute_value_ids" create="0" delete="0">
                                <list editable="bottom">
                                    <field name="attribute_id" readonly="1" force_save="1"/>
                                    <field name="required" readonly="1" force_save="1"/>
                                    <field name="value_id"
                                           domain="[('attribute_id', '=', attribute_id)]"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="color" widget="color_picker"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ter_unit_action_entrie" model="ir.actions.act_window">
        <field name="name">Territorial Units</field>
        <field name="res_model">ter.use_unit</field>
        <field name="view_mode">list,form,kanban,pivot</field>
        <field name="view_ids" eval="[(5, 0),
              (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_ter_unit_kanban')}),
              (0, 0, {'view_mode': 'list', 'view_id': ref('view_ter_unit_list')}),
              (0, 0, {'view_mode': 'form', 'view_id': ref('view_ter_unit_form')}),
              (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_ter_unit_pivot')})]"/>
        <field name="search_view_id" ref="view_ter_unit_filter"/>
        <field name="context">{'search_default_filter_validated': 1, 'search_default_filter_validity_in_range': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No territorial units yet
            </p>
        </field>
    </record>

    <menuitem id="ter_unit_action_entrie_menu"
              parent="base_ter.menu_territory"
              action="ter_unit_action_entrie"
              sequence="101"/>

    <record id="ter_unit_action_mass_validate" model="ir.actions.server">
        <field name="name">Validate</field>
        <field name="model_id" ref="base_ter.model_ter_use_unit"/>
        <field name="binding_model_id" ref="base_ter.model_ter_use_unit"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_validate()</field>
    </record>

    <record id="ter_unit_action_mass_set_to_draft" model="ir.actions.server">
        <field name="name">Set to Draft</field>
        <field name="model_id" ref="base_ter.model_ter_use_unit"/>
        <field name="binding_model_id" ref="base_ter.model_ter_use_unit"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_set_to_draft()</field>
    </record>

    <record id="ter_unit_reset_all_aerial_images_serveraction" model="ir.actions.server">
        <field name="name">Images of territorial use units (all)</field>
        <field name="model_id" ref="base_ter.model_ter_use_unit"/>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('base_ter.group_ter_director'))]"/>
        <field name="code">
            action = env["ter.unit"].action_reset_all_aerial_images(from_backend=True)
        </field>
    </record>

    <menuitem id="menu_thecnicalactions_refresh_units"
              parent="base_ter.menu_thecnicalactions_refresh"
              action="ter_unit_reset_all_aerial_images_serveraction"
              sequence="15"/>
</odoo>
