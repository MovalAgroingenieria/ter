<!-- Production method attribute on Farming. -->
<odoo>
    <data noupdate="1">

        <record id="ter_attr_production_method_farming" model="ter.use_type.attribute" >
            <field name="name">Production method</field>
            <field name="use_type_id" ref="ter_use_type_farming"/>
        </record>

        <record id="ter_attr_production_method_farming_convencional" model="ter.use_type.attribute.value" >
            <field name="name">Convencional</field>
            <field name="attribute_id" ref="ter_attr_production_method_farming"/>
        </record>
        <record id="ter_attr_production_method_farming_ecologica" model="ter.use_type.attribute.value" >
            <field name="name">Ecológica</field>
            <field name="attribute_id" ref="ter_attr_production_method_farming"/>
        </record>
        <record id="ter_attr_production_method_farming_integrada" model="ter.use_type.attribute.value" >
            <field name="name">Integrada</field>
            <field name="attribute_id" ref="ter_attr_production_method_farming"/>
        </record>

    </data>
</odoo>
