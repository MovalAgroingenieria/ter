<!-- First-level use types (parent_id = False). Data from wua.subparceltype. -->
<!-- Cultivable as attribute (not boolean): each type has attribute "Cultivable" with values Yes/No. -->
<!-- noupdate="1" = always load/update this data on module upgrade. -->
<odoo>
    <data noupdate="1">

        <record id="ter_use_type_farming" model="ter.use_type" >
            <field name="name">Farming</field>
        </record>
        <record id="ter_attr_cultivable_farming" model="ter.use_type.attribute" >
            <field name="name">Cultivable</field>
            <field name="use_type_id" ref="ter_use_type_farming"/>
        </record>
        <record id="ter_attr_cultivable_farming_yes" model="ter.use_type.attribute.value" >
            <field name="name">Yes</field>
            <field name="attribute_id" ref="ter_attr_cultivable_farming"/>
        </record>

        <record id="ter_use_type_livestock" model="ter.use_type" >
            <field name="name">Livestock</field>
        </record>
        <record id="ter_attr_cultivable_livestock" model="ter.use_type.attribute" >
            <field name="name">Cultivable</field>
            <field name="use_type_id" ref="ter_use_type_livestock"/>
        </record>
        <record id="ter_attr_cultivable_livestock_no" model="ter.use_type.attribute.value" >
            <field name="name">No</field>
            <field name="attribute_id" ref="ter_attr_cultivable_livestock"/>
        </record>

        <record id="ter_use_type_industrial" model="ter.use_type" >
            <field name="name">Industrial</field>
        </record>
        <record id="ter_attr_cultivable_industrial" model="ter.use_type.attribute" >
            <field name="name">Cultivable</field>
            <field name="use_type_id" ref="ter_use_type_industrial"/>
        </record>
        <record id="ter_attr_cultivable_industrial_no" model="ter.use_type.attribute.value" >
            <field name="name">No</field>
            <field name="attribute_id" ref="ter_attr_cultivable_industrial"/>
        </record>

        <record id="ter_use_type_urban" model="ter.use_type" >
            <field name="name">Urban</field>
        </record>
        <record id="ter_attr_cultivable_urban" model="ter.use_type.attribute" >
            <field name="name">Cultivable</field>
            <field name="use_type_id" ref="ter_use_type_urban"/>
        </record>
        <record id="ter_attr_cultivable_urban_no" model="ter.use_type.attribute.value" >
            <field name="name">No</field>
            <field name="attribute_id" ref="ter_attr_cultivable_urban"/>
        </record>

        <record id="ter_use_type_recreational" model="ter.use_type" >
            <field name="name">Recreational</field>
        </record>
        <record id="ter_attr_cultivable_recreational" model="ter.use_type.attribute" >
            <field name="name">Cultivable</field>
            <field name="use_type_id" ref="ter_use_type_recreational"/>
        </record>
        <record id="ter_attr_cultivable_recreational_no" model="ter.use_type.attribute.value" >
            <field name="name">No</field>
            <field name="attribute_id" ref="ter_attr_cultivable_recreational"/>
        </record>

        <record id="ter_use_type_water_reservoir" model="ter.use_type" >
            <field name="name">Water reservoir</field>
        </record>
        <record id="ter_attr_cultivable_water_reservoir" model="ter.use_type.attribute" >
            <field name="name">Cultivable</field>
            <field name="use_type_id" ref="ter_use_type_water_reservoir"/>
        </record>
        <record id="ter_attr_cultivable_water_reservoir_no" model="ter.use_type.attribute.value" >
            <field name="name">No</field>
            <field name="attribute_id" ref="ter_attr_cultivable_water_reservoir"/>
        </record>

    </data>
</odoo>
