<!-- Plant material provenance attribute on Farming: values from Procedencia del material vegetal.csv (active only). -->
<odoo>
    <data noupdate="0">

        <record id="ter_attr_plant_material_provenance_farming" model="ter.use_type.attribute" forcecreate="True">
            <field name="name">Plant material provenance</field>
            <field name="use_type_id" ref="ter_use_type_farming"/>
        </record>

        <record id="ter_attr_plant_material_provenance_farming_1" model="ter.use_type.attribute.value" forcecreate="True">
            <field name="name">Banco de germoplasma/recursos fitogenéticos</field>
            <field name="attribute_id" ref="ter_attr_plant_material_provenance_farming"/>
        </record>
        <record id="ter_attr_plant_material_provenance_farming_2" model="ter.use_type.attribute.value" forcecreate="True">
            <field name="name">Material de la propia explotación</field>
            <field name="attribute_id" ref="ter_attr_plant_material_provenance_farming"/>
        </record>
        <record id="ter_attr_plant_material_provenance_farming_3" model="ter.use_type.attribute.value" forcecreate="True">
            <field name="name">Material de un obtentor no registrado en ROPVEG</field>
            <field name="attribute_id" ref="ter_attr_plant_material_provenance_farming"/>
        </record>

    </data>
</odoo>