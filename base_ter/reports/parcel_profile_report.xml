<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="action_parcel_profile_report" model="ir.actions.report">
        <field name="name">Parcels by Profile</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_ter.parcel_profile_template</field>
        <field name="report_file">base_ter.parcel_profile_template</field>
        <field name="paperformat_id" ref="base_report.paperformat_euro_reports"/>
        <field name="print_report_name">'Parcels by Profile - %s' % (object.name or '')</field>
        <field name="groups_id" eval="[(4, ref('base_ter.group_ter_user'))]"/>
    </record>

    <template id="parcel_profile_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="base_ter.parcel_profile_report_document"
                   t-lang="o.lang or o.env.lang"/>
            </t>
        </t>
    </template>

    <template id="parcel_profile_report_document">
        <t t-set="o" t-value="o.with_context(lang=o.lang or o.env.lang)"/>
        <t t-call="web.external_layout">

            <t t-set="company" t-value="o.env.company"/>
            <t t-set="area_unit_name"
               t-value="o.env._('ha') if company.area_unit_is_ha else (company.area_unit_name or 'ha')"/>

            <t t-set="printing_date"
               t-value="o.env['common.format'].transform_date_to_locale(datetime.datetime.now(), lang=o.lang or o.env.lang)"/>

            <t t-set="selected_links"
               t-value="o.partnerlink_ids.filtered(lambda l: l.profile_id.id in profiles.ids)"/>
            <t t-set="report_parcels" t-value="selected_links.mapped('parcel_id')"/>

            <div class="page">
                <h2 name="title" class="text-center">Parcels by Profile</h2>

                <section name="partner_data"
                         style="margin-bottom: 20px; page-break-inside: avoid;">
                    <div name="title_partner">
                        <h2 style="font-size: 1.4em;">
                            <span class="fa fa-user"/>
                            <span>Partner</span>
                            <div style="border-top: 2px solid;"/>
                        </h2>
                    </div>

                    <strong>
                        <span t-field="o.display_name"/>
                    </strong>
                    <t t-if="o.vat">
                        <span>(VAT:&amp;nbsp;
                            <span t-field="o.vat"/>
                        </span>
                        )
                    </t>
                    <br/>

                    <div class="row" style="margin-top: 4px;">
                        <div class="col-12" style="display: table;">
                            <div style="width: 50%; display: table-cell; border-right: 1px solid lightgrey;">
                                <div t-out="o"
                                     t-options='{"widget": "contact", "no_marker": True,
                                                 "fields": ["address", "phone", "mobile", "email"]}'/>
                            </div>

                            <div style="padding-left: 32px;">
                                <table style="width: 100%;"
                                       class="table-condensed table-borderless">
                                    <tbody>
                                        <tr name="tr_profiles">
                                            <td>
                                                <span>Profiles</span>
                                            </td>
                                            <td class="text-end">
                                                <span t-out="', '.join(profiles.mapped('alphanum_code'))"/>
                                            </td>
                                        </tr>
                                        <tr name="tr_printing_date">
                                            <td>
                                                <span>Printing date</span>
                                            </td>
                                            <td class="text-end">
                                                <span t-out="printing_date"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <section name="parcels_data"
                         style="margin-bottom: 20px; page-break-inside: avoid;">
                    <div name="title_parcels">
                        <h2 style="font-size: 1.4em;">
                            <span class="fa fa-ter-parcel"/>
                            <span>Parcels</span>
                            <div style="border-top: 2px solid;"/>
                        </h2>
                    </div>

                    <table class="table table-condensed table-borderless"
                           style="width:100%;">
                        <thead>
                            <tr style="border-bottom: 1px solid lightgrey">
                                <th name="th_official_code" class="text-start">Code</th>
                                <th name="th_property_id" class="text-start">Property</th>
                                <th name="th_place_id" class="text-start">Place</th>
                                <th name="th_area_official" class="text-end">Area</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="report_parcels" t-as="parcel">
                                <tr>
                                    <td name="td_official_code">
                                        <span t-field="parcel.official_code"/>
                                    </td>
                                    <td name="td_property_id">
                                        <span t-field="parcel.property_id.name"/>
                                    </td>
                                    <td name="td_place_id">
                                        <span t-field="parcel.place_id.name"/>
                                    </td>
                                    <td name="td_area_official" class="text-end">
                                        <span t-field="parcel.area_official"/>
                                        <span t-out="area_unit_name"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </section>

            </div>
        </t>
    </template>

</odoo>
