<odoo>

    <record id="action_property_report" model="ir.actions.report">
        <field name="name">Property Report</field>
        <field name="model">ter.property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_ter.property_template</field>
        <field name="report_file">base_ter.property_template</field>
        <field name="paperformat_id" ref="base_report.paperformat_euro_reports"/>
        <field name="print_report_name">'Property - %s - %s' % (object.name, object.partner_id.name or '')</field>
        <field name="binding_model_id" ref="model_ter_property"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('base_ter.group_ter_user'))]"/>
    </record>

    <template id="property_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="base_ter.property_report_document" t-lang="o.partner_id.lang or o.env.lang"/>
            </t>
        </t>
    </template>

    <template id="property_report_document">
        <t t-set="lang" t-value="o.partner_id.lang or o.env.lang"/>
        <t t-set="o" t-value="o.with_context(lang=lang)"/>
        <t t-call="web.external_layout">

            <!-- Vars -->
            <t t-set="company" t-value="o.env.company"/>
            <t t-set="area_unit_is_ha" t-value="company.area_unit_is_ha"/>
            <t t-set="area_unit_name"
               t-value="o.env._('ha') if company.area_unit_is_ha else (company.area_unit_name or 'ha')"/>

            <t t-set="printing_date"
               t-value="o.env['common.format'].transform_date_to_locale(datetime.datetime.now(), lang=lang)"/>

            <div class="page">
                <h2 name="title" class="text-center">Property Report</h2>

                <section name="partner_data" style="margin-bottom: 20px; page-break-inside: avoid;">
                    <div name="title_partner">
                        <h2 style="font-size: 1.4em;">
                            <span class="fa fa-user"/>
                            <span>Partner</span>
                            <div style="border-top: 2px solid;"/>
                        </h2>
                    </div>

                    <strong>
                        <span t-field="o.partner_id.display_name"/>
                    </strong>
                    <t t-if="o.partner_id.vat">
                        <span>(VAT:&amp;nbsp;
                            <span t-field="o.partner_id.vat"/>
                        </span>
                        )
                    </t>
                    <br/>

                    <div class="row" style="margin-top: 4px;">
                        <div class="col-12" style="display: table;">
                            <div style="width: 50%; display: table-cell; border-right: 1px solid lightgrey;">
                                <div t-field="o.partner_id"
                                     t-options='{"widget": "contact", "no_marker": True,
                                                 "fields": ["address", "phone", "mobile", "email"]}'/>
                            </div>

                            <div style="padding-left: 32px;">
                                <table style="width: 100%;" class="table-condensed table-borderless">
                                    <tbody>
                                        <tr name="tr_number_of_properties">
                                            <td>
                                                <span>Number of properties</span>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="o.partner_id.number_of_properties"/>
                                            </td>
                                        </tr>
                                        <tr name="tr_printing_date">
                                            <td>
                                                <span>Printing date</span>
                                            </td>
                                            <td class="text-end">
                                                <span t-out="printing_date"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <section name="property_data" style="margin-bottom: 20px; page-break-inside: avoid;">
                    <div name="title_property">
                        <h2 style="font-size: 1.4em;">
                            <span class="fa fa-ter-property"/>
                            <span>Property</span>
                            <div style="border-top: 2px solid;"/>
                        </h2>
                    </div>

                    <div class="row" style="margin-top: 4px;">
                        <div class="col-12" style="display: table;">
                            <div style="width: 50%; padding-right: 32px; display: table-cell; border-right: 1px solid lightgrey;">
                                <table name="property_basic_data" style="width: 100%;"
                                       class="table-condensed table-borderless">
                                    <tbody>
                                        <tr name="tr_municipality">
                                            <td>
                                                <span>Municipality</span>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="o.municipality_id.name"/>
                                            </td>
                                        </tr>
                                        <tr name="tr_area_official_parcels">
                                            <td>
                                                <span>Area official parcels</span>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="o.area_official_parcels"/>
                                                <span t-out="area_unit_name"/>
                                            </td>
                                        </tr>
                                        <tr name="tr_place">
                                            <td>
                                                <span>Place</span>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="o.place_id.name"/>
                                            </td>
                                        </tr>
                                        <t t-if="o.tag_id">
                                            <tr name="tr_tags">
                                                <td>
                                                    <span>Tags</span>
                                                </td>
                                                <td class="text-end">
                                                    <span t-field="o.tag_id"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>

                            <div style="padding-left: 32px;">
                                <table name="property_area_data" style="width:100%;"
                                       class="table-condensed table-borderless">
                                    <tbody>
                                        <tr name="tr_area_official_m2">
                                            <td>
                                                <span>Area official</span>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="o.area_official_parcels_m2"/>
                                                <span>m²</span>
                                            </td>
                                        </tr>
                                        <tr name="tr_area_gis">
                                            <td>
                                                <span>GIS Area</span>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="o.area_gis"/>
                                                <span>m²</span>
                                            </td>
                                        </tr>
                                        <tr name="tr_perimeter_gis">
                                            <td>
                                                <span>GIS Perimeter</span>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="o.perimeter_gis"/>
                                                <span>m</span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <section name="aerial_image" style="margin-bottom: 20px; page-break-inside: avoid;">
                    <div name="title_aerial_image">
                        <h2 style="font-size: 1.4em;">
                            <span class="fa fa-picture-o"/>
                            <span>Aerial Image</span>
                            <div style="border-top: 2px solid;"/>
                        </h2>
                    </div>

                    <div name="aerial_image" class="text-center" style="border: 1px solid black; padding: 1% 0%;">
                        <t t-if="o.aerial_image_shown_b64">
                            <img t-attf-src="data:image/png;base64, #{o.aerial_image_shown_b64}"
                                 style="max-width: 824px; max-height: 824px;"/>
                        </t>
                        <t t-else="">
                            <div class="text-center text-muted" style="padding: 6% 0%;">
                                <div class="fa fa-file-image-o" style="font-size: 4em;"/>
                                <br/>
                                <div>Aerial image not found</div>
                            </div>
                        </t>
                    </div>

                    <div style="display: table; border: 1px solid black; border-top: 0; width: 100%;">
                        <div class="text-center"
                             style="padding: 1%; border-right: 1px solid black; width: 20%; display: table-cell;">
                            <img src="/web/binary/company_logo" style="max-height: 100px; max-width: 100px;"/>
                        </div>

                        <div style="border-right: 1px solid black; width: 40%; display: table-cell; vertical-align: top;">
                            <div style="padding: 2%;">
                                <strong>
                                    <span t-field="o.name"/>
                                </strong>
                            </div>
                            <hr style="margin: 0; padding: 0; border-top: 1px solid black"/>
                            <div style="padding: 2%;">
                                Municipality:
                                <strong>
                                    <span t-field="o.municipality_id.name"/>
                                </strong>
                                <br/>
                                Place:
                                <strong>
                                    <span t-field="o.place_id.name"/>
                                </strong>
                                <br/>
                                Parcels Area:
                                <strong>
                                    <span t-field="o.area_official_parcels"/>
                                    <span t-out="area_unit_name"/>
                                </strong>
                                <br/>
                            </div>
                        </div>

                        <div style="width: 40%; display: table-cell; vertical-align: top;">
                            <div class="text-end" style="padding: 2%;">
                                Printing date
                                <span t-out="printing_date"/>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

</odoo>
