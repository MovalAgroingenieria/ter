<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_ter_user" model="res.groups">
        <field name="name">Reader User</field>
        <field name="category_id" ref="base.module_category_territory_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_ter_manager" model="res.groups">
        <field name="name">Writer User</field>
        <field name="category_id" ref="base.module_category_territory_management"/>
        <field name="implied_ids" eval="[(4, ref('group_ter_user'))]"/>
    </record>

    <record id="group_ter_director" model="res.groups">
        <field name="name">Director</field>
        <field name="category_id" ref="base.module_category_territory_management"/>
        <field name="implied_ids" eval="[(4, ref('group_ter_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_ter_import_kml" model="res.groups">
        <field name="name">KML Importer</field>
        <field name="comment">Allow importing parcels and properties from KML files.</field>
        <field name="category_id" ref="base.module_category_territory_management"/>
        <field name="implied_ids" eval="[(4, ref('group_ter_manager'))]"/>
    </record>

    <record id="rule_no_delete_used_attribute" model="ir.rule">
        <field name="name">No delete used attributes</field>
        <field name="model_id" ref="model_ter_use_type_attribute"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
     <record id="ter_unit_rule_portal" model="ir.rule">
        <field name="name">Territorial Unit: Portal Users - Own Records Only</field>
        <field name="model_id" ref="base_ter.model_ter_unit"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
