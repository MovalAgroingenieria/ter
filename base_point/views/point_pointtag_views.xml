<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="point_pointtag_view_list" model="ir.ui.view">
        <field name="name">point.pointtag.tree</field>
        <field name="model">point.pointtag</field>
        <field name="arch" type="xml">
            <list>
                <field name="alphanum_code"/>
                <field name="color"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="point_pointtag_view_form" model="ir.ui.view">
        <field name="name">point.pointtag.form</field>
        <field name="model">point.pointtag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="alphanum_code"/>
                        <field name="color"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
