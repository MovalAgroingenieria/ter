<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_point_profile_tree" model="ir.ui.view">
        <field name="name">point.profile.tree</field>
        <field name="model">point.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="alphanum_code"/>
                <field name="requires_total"/>
                <field name="is_standard"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_point_profile_form" model="ir.ui.view">
        <field name="name">point.profile.form</field>
        <field name="model">point.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="alphanum_code"/>
                        <field name="requires_total"/>
                        <field name="is_standard"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
