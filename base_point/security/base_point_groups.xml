<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="module_category_point_management" model="ir.module.category">
        <field name="name">Point Management</field>
        <field name="sequence" eval="200"/>
    </record>

    <record id="group_point_user" model="res.groups">
        <field name="name">Reader User</field>
        <field name="category_id" ref="base_point.module_category_point_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_point_manager" model="res.groups">
        <field name="name">Writer User</field>
        <field name="category_id" ref="base_point.module_category_point_management"/>
        <field name="implied_ids" eval="[(4, ref('base_point.group_point_user'))]"/>
    </record>

    <record id="group_point_director" model="res.groups">
        <field name="name">Director</field>
        <field name="category_id" ref="base_point.module_category_point_management"/>
        <field name="implied_ids" eval="[(4, ref('base_point.group_point_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>
</odoo>
