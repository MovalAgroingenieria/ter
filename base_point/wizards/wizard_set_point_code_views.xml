<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="wizard_set_point_code_view_form" model="ir.ui.view">
        <field name="name">wizard.set.point.code.form</field>
        <field name="model">wizard.set.point.code</field>
        <field name="arch" type="xml">
            <form string="Set Point Code">
                <group>
                    <field name="point_code"/>
                </group>
                <footer>
                    <button name="set_point_code" string="Apply" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_set_point_code_action" model="ir.actions.act_window">
        <field name="name">Set Point Code</field>
        <field name="res_model">wizard.set.point.code</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
