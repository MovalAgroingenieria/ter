<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="ter_parcel_view_form" model="ir.ui.view">
        <field name="name">ter.parcel.view.form.l10n_es_territory</field>
        <field name="model">ter.parcel</field>
        <field name="inherit_id" ref="base_ter.ter_parcel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_gis_viewer']" position="before">
                <field name="cadastre_gis_import_enabled" invisible="1"/>
                <field name="geom_ewkt" invisible="1"/>
                <button
                    name="action_get_gis_data_from_cadastre"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-globe"
                    invisible="not cadastre_gis_import_enabled or not official_code or geom_ewkt"
                >
                    <span>Import GIS</span>
                </button>
                <button
                    name="action_show_cadastral_form"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-cubes"
                    invisible="not official_code"
                >
                    <span>Cadastre</span>
                </button>
            </xpath>

            <xpath expr="//field[@name='place_id']" position="after">
                <field name="parcel_type" widget="radio" options="{'horizontal': true}"/>

                <field name="official_code_urban" invisible="parcel_type != '02_U'"/>

                <div name="cadastral_name" class="o_form_label" invisible="parcel_type != '01_R'">
                    Sec / Pol / Par
                </div>

                <div
                    name="div_line_cadastral_fields"
                    class="o_address_format"
                    style="display: flex; gap: 10px;"
                    invisible="parcel_type != '01_R'"
                >
                    <field name="cadastral_sector" style="min-width:17px; max-width:17px"/>
                    <span>/</span>
                    <field name="cadastral_polygon" style="min-width:20px; max-width:20px"/>
                    <span>/</span>
                    <field name="cadastral_parcel" style="min-width:27px; max-width:27px"/>
                </div>
            </xpath>

            <xpath expr="//field[@name='official_code']" position="attributes">
                <attribute name="invisible">parcel_type != '01_R'</attribute>
            </xpath>

            <xpath expr="//field[@name='official_code']" position="after">
                <field name="cadastral_subparcel" invisible="parcel_type == '02_U'"/>
            </xpath>

            <xpath expr="//field[@name='area_official']" position="after">
                <field name="cadastral_area"/>
            </xpath>
        </field>
    </record>

    <record id="ter_parcel_view_tree" model="ir.ui.view">
        <field name="name">ter.parcel.view.list.l10n_es_territory</field>
        <field name="model">ter.parcel</field>
        <field name="inherit_id" ref="base_ter.ter_parcel_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='area_official']" position="after">
                <field name="official_code" invisible="1"/>
                <button
                    name="action_show_cadastral_form"
                    title="Cadastre"
                    type="object"
                    icon="fa-cubes"
                    class="oe_stat_button o_list_button"
                    invisible="not official_code"
                />
            </xpath>
        </field>
    </record>

    <record id="ter_parcel_import_gis_from_cadastre_serveraction" model="ir.actions.server">
        <field name="name">Import GIS from Cadastre</field>
        <field name="model_id" ref="base_ter.model_ter_parcel"/>
        <field name="binding_model_id" ref="base_ter.model_ter_parcel"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_get_gis_data_from_cadastre()</field>
    </record>

    <record id="ter_parcel_delete_gis_geometry_serveraction" model="ir.actions.server">
        <field name="name">Delete GIS geometry</field>
        <field name="model_id" ref="base_ter.model_ter_parcel"/>
        <field name="binding_model_id" ref="base_ter.model_ter_parcel"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('base_ter.group_ter_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_delete_gis_geometry()</field>
    </record>

    <record id="ter_parcel_view_search" model="ir.ui.view">
        <field name="name">ter.parcel.view.search.l10n_es_territory</field>
        <field name="model">ter.parcel</field>
        <field name="inherit_id" ref="base_ter.ter_parcel_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='partner_id_no']" position="after">
                <separator/>
                <filter
                    name="parcel_type_01_r"
                    string="Parcel Type: Rustic"
                    domain="[('parcel_type', '=', '01_R')]"
                />
                <filter
                    name="parcel_type_02_u"
                    string="Parcel Type: Urban"
                    domain="[('parcel_type', '=', '02_U')]"
                />
            </xpath>

            <xpath expr="//filter[@name='grouped_by_property_id']" position="after">
                <filter
                    name="grouped_by_parcel_type"
                    string="Parcel Type"
                    context="{'group_by': 'parcel_type'}"
                />
            </xpath>
        </field>
    </record>

</odoo>
