<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_admregion_view_form_inherit_l10n_es_territory" model="ir.ui.view">
        <field name="name">res.admregion.form.inherit.l10n_es_territory</field>
        <field name="model">res.admregion</field>
        <field name="inherit_id" ref="base_adi.res_admregion_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_show_provinces']" position="after">
                <button
                    name="action_show_municipalities"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-map-marker"
                >
                    <field
                        name="number_of_municipalities"
                        string="Municipalities"
                        widget="statinfo"
                    />
                </button>
                <button
                    name="action_show_places"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-map-signs"
                >
                    <field
                        name="number_of_places"
                        string="Places"
                        widget="statinfo"
                    />
                </button>
            </xpath>
        </field>
    </record>

    <record id="res_admregion_view_kanban" model="ir.ui.view">
        <field name="name">res.admregion.view.kanban</field>
        <field name="model">res.admregion</field>
        <field name="arch" type="xml">
            <kanban class="o_l10n_es_territory_kanban_small">
                <field name="id"/>
                <field name="alphanum_code"/>
                <field name="flag_image_64"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <field name="flag_image_64" widget="image" class="o_kanban_image_inner"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="alphanum_code"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
