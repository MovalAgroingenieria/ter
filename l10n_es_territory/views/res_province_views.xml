<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_province_view_form" model="ir.ui.view">
        <field name="name">res.province.view.form.l10n_es_territory</field>
        <field name="model">res.province</field>
        <field name="inherit_id" ref="base_adi.res_province_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_show_municipalities']" position="after">
                <button
                    name="action_show_places"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-map-signs"
                >
                    <field
                        name="number_of_places"
                        string="Places"
                        widget="statinfo"
                    />
                </button>
            </xpath>
            <xpath expr="//group[@name='master_data_right']" position="inside">
                <field name="image_128" widget="image" class="oe_avatar"/>
            </xpath>
            <xpath expr="//field[@name='region_id']" position="after">
                <field name="cadastral_code"/>
            </xpath>
        </field>
    </record>

    <record id="res_province_view_list" model="ir.ui.view">
        <field name="name">res.province.view.list.l10n_es_territory</field>
        <field name="model">res.province</field>
        <field name="inherit_id" ref="base_adi.res_province_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">cadastral_code</attribute>
            </xpath>
            <xpath expr="//field[@name='alphanum_code']" position="before">
                <field name="cadastral_code" class="text-center"/>
            </xpath>
        </field>
    </record>

    <record id="res_province_view_kanban" model="ir.ui.view">
        <field name="name">res.province.view.kanban</field>
        <field name="model">res.province</field>
        <field name="arch" type="xml">
            <kanban class="o_l10n_es_territory_kanban_small">
                <field name="id"/>
                <field name="alphanum_code"/>
                <field name="region_id"/>
                <field name="image_128"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <field name="image_128" widget="image" class="o_kanban_image_inner"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="alphanum_code"/></strong>
                                <div><field name="region_id" widget="many2one"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="res_province_view_search" model="ir.ui.view">
        <field name="name">res.province.view.search.l10n_es_territory</field>
        <field name="model">res.province</field>
        <field name="inherit_id" ref="base_adi.res_province_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='region_id']" position="after">
                <field name="cadastral_code"/>
            </xpath>
        </field>
    </record>

</odoo>
