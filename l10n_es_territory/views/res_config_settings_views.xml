<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_config_settings_view_form_inherit_l10n_es_territory" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n.es.territory</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_ter.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='base_ter_gis_viewer']" position="before">
                <block title="Cadastre" name="l10n_es_territory_cadastre">
                    <setting id="l10n_es_territory_cadastre_gis_import_enabled"
                             string="Enable parcel geometry import from Cadastre"
                             help="If enabled, parcels can import GIS geometry from the official Cadastre WFS service.">
                        <field name="cadastre_gis_import_enabled"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
