<odoo>

    <record id="res_config_settings_view_form_inherit_l10n_es_territory" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_es_territory</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_ter.res_config_settings_view_form"/>    <field name="arch" type="xml">

            <!-- Hide base_ter global fields and inject company-dependent fields -->
            <xpath expr="//setting[@id='base_ter_aerial_image_wmsbase_url']//field[@name='aerial_image_wmsbase_url']"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//setting[@id='base_ter_aerial_image_wmsbase_url']//field[@name='aerial_image_wmsbase_url']"
                   position="after">
                <field name="base_ter_aerial_image_wmsbase_url" style="width: 100%;"/>
            </xpath>

            <xpath expr="//setting[@id='base_ter_aerial_image_wmsbase_layers']//field[@name='aerial_image_wmsbase_layers']"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//setting[@id='base_ter_aerial_image_wmsbase_layers']//field[@name='aerial_image_wmsbase_layers']"
                   position="after">
                <field name="base_ter_aerial_image_wmsbase_layers" style="width: 100%;"/>
            </xpath>

        </field>
    </record>

</odoo>
