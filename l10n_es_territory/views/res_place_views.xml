<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_place_view_form_inherit_l10n_es_territory" model="ir.ui.view">
        <field name="name">res.place.form.inherit.l10n_es_territory</field>
        <field name="model">res.place</field>
        <field name="inherit_id" ref="base_adi.res_place_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='master_data_right']" position="inside">
                <field name="image_128" widget="image" class="oe_avatar"/>
            </xpath>
        </field>
    </record>

    <record id="res_place_view_kanban" model="ir.ui.view">
        <field name="name">res.place.view.kanban</field>
        <field name="model">res.place</field>
        <field name="arch" type="xml">
            <kanban class="o_l10n_es_territory_kanban_small">
                <field name="id"/>
                <field name="alphanum_code"/>
                <field name="municipality_id"/>
                <field name="image_128"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <field name="image_128" widget="image" class="o_kanban_image_inner"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="alphanum_code"/></strong>
                                <div><field name="municipality_id" widget="many2one"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
