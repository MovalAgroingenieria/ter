<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="maintenance_request_view_form_inherit_geofolia" model="ir.ui.view">
        <field name="name">maintenance.request.form.inherit.geofolia</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Geofolia" name="geofolia" groups="geofolia_json_import.group_geofolia_import">
                    <field name="geofolia_action_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="maintenance_request_view_list_inherit_geofolia" model="ir.ui.view">
        <field name="name">maintenance.request.list.inherit.geofolia</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="geofolia_action_id" string="Geofolia Action ID" optional="show" groups="geofolia_json_import.group_geofolia_import"/>
            </xpath>
        </field>
    </record>

    <record id="maintenance_request_view_search_inherit_geofolia" model="ir.ui.view">
        <field name="name">maintenance.request.search.inherit.geofolia</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='name']" position="after">
                <field name="geofolia_action_id" groups="geofolia_json_import.group_geofolia_import"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="from_geofolia" string="From Geofolia"
                        domain="[('geofolia_action_id', '!=', False)]"
                        groups="geofolia_json_import.group_geofolia_import"/>
            </xpath>
        </field>
    </record>
</odoo>
