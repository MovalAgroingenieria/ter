<odoo>
    <menuitem id="menu_geofolia_import"
              name="Geofolia"
              parent="base_ter.menu_configuration_general"
              groups="group_geofolia_import"/>

    <record id="action_geofolia_import_job" model="ir.actions.act_window">
        <field name="name">Import Jobs</field>
        <field name="res_model">geofolia.import.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_geofolia_import_jobs"
              name="Jobs"
              parent="menu_geofolia_import"
              action="action_geofolia_import_job"
              groups="group_geofolia_import"/>

    <!-- LIST -->
    <record id="view_geofolia_import_job_list" model="ir.ui.view">
        <field name="name">geofolia.import.job.list</field>
        <field name="model">geofolia.import.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="import_type"/>
                <field name="state"/>
                <field name="line_count" invisible="import_type in ('full')"/>
                <field name="file_name"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_geofolia_import_job_form" model="ir.ui.view">
        <field name="name">geofolia.import.job.form</field>
        <field name="model">geofolia.import.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_parse"
                            type="object"
                            string="Parse"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,error"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="import_type"/>
                        <field name="file_name" readonly="1"/>
                        <field name="file_data" filename="file_name"/>
                    </group>

                    <group string="Information">
                        <field name="info_json" nolabel="1"/>
                    </group>

                    <group string="Error" invisible="state != 'error'">
                        <field name="error" nolabel="1"/>
                    </group>

                    <notebook>
                        <!-- SIMPLE MODE -->
                        <page string="Lines" invisible="import_type == 'full'">
                            <field name="line_ids">
                                <list>
                                    <field name="external_uuid"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="city" invisible="import_type != 'fields'"/>
                                    <field name="crop_name" invisible="import_type != 'fields'"/>
                                    <field name="unit_symbol" invisible="import_type != 'products'"/>
                                    <field name="category_enum" invisible="import_type != 'products'"/>

                                    <!-- Debug -->
                                    <field name="raw_json_text" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- FULL MODE -->
                        <page string="Products" invisible="import_type != 'full'">
                            <field name="product_line_ids">
                                <list>
                                    <field name="farm_identification_code"/>
                                    <field name="external_id"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="category_enum"/>
                                    <field name="product_type_enum"/>
                                    <field name="unit_symbol"/>

                                    <!-- Debug -->
                                    <field name="raw_json_text" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Employees" invisible="import_type != 'full'">
                            <field name="employee_line_ids">
                                <list>
                                    <field name="external_id"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>

                                    <!-- Debug -->
                                    <field name="raw_json_text" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Partners" invisible="import_type != 'full'">
                            <field name="partner_line_ids">
                                <list>
                                    <field name="external_id"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="vat"/>

                                    <!-- Debug -->
                                    <field name="raw_json_text" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Harvested Products" invisible="import_type != 'full'">
                            <field name="harvested_product_line_ids">
                                <list>
                                    <field name="external_id"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="unit_symbol"/>

                                    <!-- Debug -->
                                    <field name="raw_json_text" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Equipments" invisible="import_type != 'full'">
                            <field name="equipment_line_ids">
                                <list>
                                    <field name="external_id"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="category"/>

                                    <!-- Debug -->
                                    <field name="raw_json_text" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Activities" invisible="import_type != 'full'">
                            <field name="activity_line_ids">
                                <list>
                                    <field name="starting_date"/>
                                    <field name="ending_date"/>
                                    <field name="start_time"/>
                                    <field name="finish_time"/>
                                    <field name="duration_minutes"/>

                                    <field name="external_id"/>
                                    <field name="farm_identification_code"/>
                                    <field name="harvest_year"/>

                                    <field name="operation_name"/>
                                    <field name="operation_category"/>
                                    <field name="status_name"/>
                                    <field name="status_code"/>

                                    <!-- Debug -->
                                    <field name="raw_json_text" invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WIZARD ACTION -->
    <record id="action_geofolia_import_wizard_menu" model="ir.actions.act_window">
        <field name="name">New Import</field>
        <field name="res_model">geofolia.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_geofolia_import_new"
              name="New Import"
              parent="menu_geofolia_import"
              action="action_geofolia_import_wizard_menu"
              groups="group_geofolia_import"/>
</odoo>
