<odoo>
    <menuitem id="menu_geofolia_import" name="Geofolia" parent="base_ter.menu_configuration_general" groups="group_geofolia_import"/>

    <record id="action_geofolia_import_job" model="ir.actions.act_window">
        <field name="name">Import Jobs</field>
        <field name="res_model">geofolia.import.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_geofolia_import_jobs" name="Jobs" parent="menu_geofolia_import"
              action="action_geofolia_import_job" groups="group_geofolia_import"/>

    <record id="view_geofolia_import_job_list" model="ir.ui.view">
        <field name="name">geofolia.import.job.list</field>
        <field name="model">geofolia.import.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="import_type"/>
                <field name="state"/>
                <field name="line_count"/>
                <field name="file_name"/>
            </list>
        </field>
    </record>

    <record id="view_geofolia_import_job_form" model="ir.ui.view">
        <field name="name">geofolia.import.job.form</field>
        <field name="model">geofolia.import.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_parse" type="object" string="Parse" class="btn-primary"
                            invisible="state == 'done'"
                            />
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,error"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="import_type"/>
                        <field name="file_name"/>
                        <field name="file_data" filename="file_name"/>
                    </group>

                    <group string="Information">
                        <field name="info_json" nolabel="1"/>
                    </group>

                    <group invisible="state != 'error'">
                        <field name="error" nolabel="1"/>
                    </group>

                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list>
                                    <field name="external_uuid"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="city" invisible="import_type != 'fields'"/>
                                    <field name="crop_name" attrsinvisible="import_type != 'fields'"/>
                                    <field name="unit_symbol" invisible="import_type != 'products'"/>
                                    <field name="category_enum" invisible="import_type != 'products'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_geofolia_import_wizard_menu" model="ir.actions.act_window">
        <field name="name">New Import</field>
        <field name="res_model">geofolia.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_geofolia_import_new" name="New Import" parent="menu_geofolia_import"
              action="action_geofolia_import_wizard_menu" groups="group_geofolia_import"/>
</odoo>
