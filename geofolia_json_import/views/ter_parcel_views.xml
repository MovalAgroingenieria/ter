<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ter_parcel_view_search_inherit_geofolia" model="ir.ui.view">
        <field name="name">ter.parcel.search.inherit.geofolia</field>
        <field name="model">ter.parcel</field>
        <field name="inherit_id" ref="base_ter.ter_parcel_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='mapped_to_polygon_no']" position="after">
                <separator/>
                <filter name="from_geofolia" string="From Geofolia"
                        domain="[('geofolia_farm_identification_code', '!=', False)]"
                        groups="geofolia_json_import.group_geofolia_import"/>
            </xpath>
        </field>
    </record>

    <record id="ter_parcel_view_form_inherit_geofolia" model="ir.ui.view">
        <field name="name">ter.parcel.form.inherit.geofolia</field>
        <field name="model">ter.parcel</field>
        <field name="inherit_id" ref="base_ter.ter_parcel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_show_timesheets" type="object"
                        class="oe_stat_button" icon="fa-clock-o">
                    <field name="timesheet_count" string="Timesheets" widget="statinfo"/>
                </button>
                <button name="action_show_tasks" type="object"
                        class="oe_stat_button" icon="fa-tasks">
                    <field name="task_count" string="Tasks" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='page_notes']" position="before">
                <page string="Geofolia" name="geofolia" groups="geofolia_json_import.group_geofolia_import">
                    <group>
                        <group>
                            <field name="geofolia_farm_identification_code"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
