<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ter_unit_view_form_inherit_geofolia" model="ir.ui.view">
        <field name="name">ter.unit.form.inherit.geofolia</field>
        <field name="model">ter.unit</field>
        <field name="inherit_id" ref="base_ter.view_ter_unit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page" position="before">
                <page string="Geofolia" name="geofolia">
                    <group>
                        <group string="Identification">
                            <field name="geofolia_uid" readonly="1"/>
                            <field name="geofolia_code"/>
                            <field name="geofolia_name"/>
                            <field name="geofolia_parent_id1"/>
                            <field name="geofolia_main_plot_id"/>
                        </group>
                        <group string="Dates &amp; Area">
                            <field name="geofolia_last_modification_date" readonly="1"/>
                            <field name="geofolia_last_modification_geometry_date" readonly="1"/>
                            <field name="geofolia_area"/>
                            <field name="geofolia_unit"/>
                        </group>
                    </group>
                    <group>
                        <group string="Crop">
                            <field name="geofolia_crop_name"/>
                            <field name="geofolia_botanical_species_code"/>
                            <field name="geofolia_variety_name"/>
                        </group>
                        <group string="Plot &amp; Irrigation">
                            <field name="geofolia_plot_kind"/>
                            <field name="geofolia_plot_kind_name"/>
                            <field name="geofolia_irrigation_kind"/>
                            <field name="geofolia_irrigation_kind_name"/>
                        </group>
                    </group>
                    <group string="Comments">
                        <field name="geofolia_comment" nolabel="1" placeholder="Comment"/>
                        <field name="geofolia_ferti_diary_comment" nolabel="1" placeholder="Ferti diary comment"/>
                        <field name="geofolia_phyto_diary_comment" nolabel="1" placeholder="Phyto diary comment"/>
                    </group>
                    <group string="Geography (WKT)" optional="hide">
                        <field name="geofolia_geography" nolabel="1" widget="text"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
