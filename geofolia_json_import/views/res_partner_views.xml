<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_inherit_geofolia" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.geofolia</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_ter.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Geofolia" name="geofolia" groups="geofolia_json_import.group_geofolia_import">
                    <group>
                        <group string="Identification">
                            <field name="geofolia_partner_id"/>
                            <field name="geofolia_registration_number" readonly="1"/>
                            <field name="geofolia_national_identification_code" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_list_inherit_geofolia" model="ir.ui.view">
        <field name="name">res.partner.list.inherit.geofolia</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_ter.res_partner_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="geofolia_partner_id" string="Geofolia Partner ID" optional="show" groups="geofolia_json_import.group_geofolia_import"/>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_search_inherit_geofolia" model="ir.ui.view">
        <field name="name">res.partner.search.inherit.geofolia</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_ter.res_partner_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_code']" position="after">
                <field name="geofolia_partner_id" groups="geofolia_json_import.group_geofolia_import"/>
            </xpath>
        </field>
    </record>
</odoo>
