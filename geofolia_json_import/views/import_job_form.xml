<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_geofolia_import_job_form" model="ir.ui.view">
        <field name="name">geofolia.import.job.form</field>
        <field name="model">geofolia.import.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply_fields"
                            type="object"
                            string="Apply"
                            class="btn-primary"
                            invisible="import_type != 'fields' or state != 'done'"/>
                    <button name="action_parse"
                            type="object"
                            string="Parse"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="action_apply"
                            type="object"
                            string="Apply all"
                            class="btn-primary"
                            invisible="import_type != 'full' or state != 'done'"/>
                    <button name="action_apply_pending"
                            type="object"
                            string="Apply pending"
                            invisible="import_type != 'full' or state != 'done'"/>
                    <field name="apply_state"
                           widget="statusbar"
                           statusbar_visible="draft,ready,partial,done,error"
                           invisible="import_type != 'full'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,done,error"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="import_type"/>
                        <field name="date_range_id" options="{'no_create': True}"/>
                        <field name="file_name" readonly="1"/>
                        <field name="file_data" filename="file_name"/>
                    </group>
                    <group invisible="import_type != 'full'">
                        <field name="total_count" readonly="1"/>
                        <field name="pending_count" readonly="1"/>
                        <field name="processed_count" readonly="1"/>
                        <field name="error_count" readonly="1"/>
                    </group>
                    <group string="Information">
                        <field name="info_json" nolabel="1"/>
                    </group>
                    <group string="Error" invisible="state != 'error'">
                        <field name="error" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Lines" invisible="import_type == 'full'">
                            <field name="line_ids">
                                <list decoration-success="sync_state in ('created','updated')"
                                      decoration-warning="sync_state == 'pending'"
                                      decoration-muted="sync_state in ('skipped','no_action')"
                                      decoration-danger="sync_state == 'error'">
                                    <header>
                                        <button name="action_transform" type="object" string="Apply selected" class="btn-primary"/>
                                    </header>
                                    <field name="sync_state"/>
                                    <field name="sync_message" optional="hide"/>
                                    <field name="external_uuid"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="ter_unit_id" optional="hide"/>
                                    <field name="city" invisible="import_type != 'fields'"/>
                                    <field name="crop_name" invisible="import_type != 'fields'"/>
                                    <field name="unit_symbol" invisible="import_type != 'products'"/>
                                    <field name="category_enum" invisible="import_type != 'products'"/>
                                    <field name="raw_json_text" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Products" invisible="import_type != 'full'">
                            <field name="product_line_ids">
                                <list decoration-success="sync_state in ('created','updated')"
                                      decoration-warning="sync_state == 'pending'"
                                      decoration-muted="sync_state in ('skipped','no_action')"
                                      decoration-danger="sync_state == 'error'">
                                    <header>
                                        <button name="action_transform" type="object" string="Apply selected" class="btn-primary"/>
                                    </header>
                                    <field name="sync_state"/>
                                    <field name="sync_message" optional="hide"/>
                                    <field name="external_id"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="rn_reference_supply_name"/>
                                    <field name="rn_reference_supply_code"/>
                                    <field name="unit_symbol"/>
                                    <field name="product_form_enum"/>
                                    <field name="product_id"/>
                                    <field name="raw_json_text" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Employees" invisible="import_type != 'full'">
                            <field name="employee_line_ids">
                                <list decoration-success="sync_state in ('created','updated')"
                                      decoration-warning="sync_state == 'pending'"
                                      decoration-muted="sync_state in ('skipped','no_action')"
                                      decoration-danger="sync_state == 'error'">
                                    <header>
                                        <button name="action_transform" type="object" string="Apply selected" class="btn-primary"/>
                                    </header>
                                    <field name="sync_state"/>
                                    <field name="sync_message" optional="hide"/>
                                    <field name="external_id"/>
                                    <field name="name"/>
                                    <field name="first_name"/>
                                    <field name="national_identification_code"/>
                                    <field name="specific_number"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="employee_id"/>
                                    <field name="raw_json_text" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Partners" invisible="import_type != 'full'">
                            <field name="partner_line_ids">
                                <list decoration-success="sync_state in ('created','updated')"
                                      decoration-warning="sync_state == 'pending'"
                                      decoration-muted="sync_state in ('skipped','no_action')"
                                      decoration-danger="sync_state == 'error'">
                                    <field name="sync_state"/>
                                    <field name="sync_message" optional="hide"/>
                                    <field name="external_id"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="vat"/>
                                    <field name="partner_id" optional="hide"/>
                                    <field name="raw_json_text" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Harvested Products" invisible="import_type != 'full'">
                            <field name="harvested_product_line_ids">
                                <list decoration-success="sync_state in ('created','updated')"
                                      decoration-warning="sync_state == 'pending'"
                                      decoration-muted="sync_state in ('skipped','no_action')"
                                      decoration-danger="sync_state == 'error'">
                                    <header>
                                        <button name="action_transform" type="object" string="Apply selected" class="btn-primary"/>
                                    </header>
                                    <field name="sync_state"/>
                                    <field name="sync_message" optional="hide"/>
                                    <field name="external_id"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="unit_symbol"/>
                                    <field name="product_id" optional="hide"/>
                                    <field name="raw_json_text" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Equipments" invisible="import_type != 'full'">
                            <field name="equipment_line_ids">
                                <list decoration-success="sync_state in ('created','updated')"
                                      decoration-warning="sync_state == 'pending'"
                                      decoration-muted="sync_state in ('skipped','no_action')"
                                      decoration-danger="sync_state == 'error'">
                                    <header>
                                        <button name="action_transform" type="object" string="Apply selected" class="btn-primary"/>
                                    </header>
                                    <field name="sync_state"/>
                                    <field name="sync_message" optional="hide"/>
                                    <field name="external_id"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="equipment_id" optional="hide"/>
                                    <field name="raw_json_text" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Activities" invisible="import_type != 'full'">
                            <field name="activity_line_ids">
                                <list>
                                    <field name="external_id"/>
                                    <field name="starting_date"/>
                                    <field name="ending_date"/>
                                    <field name="duration_minutes"/>
                                    <field name="operation_name"/>
                                    <field name="status_name"/>
                                    <field name="maintenance_request_id" optional="hide"/>
                                    <field name="comment" optional="hide"/>
                                    <field name="raw_json_text" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Activity Employees" invisible="import_type != 'full'">
                            <field name="activity_employee_line_ids">
                                <list decoration-success="sync_state in ('created','updated')"
                                      decoration-warning="sync_state == 'pending'"
                                      decoration-muted="sync_state in ('skipped','no_action')"
                                      decoration-danger="sync_state == 'error'">
                                    <header>
                                        <button name="action_transform" type="object" string="Apply selected" class="btn-primary"/>
                                    </header>
                                    <field name="sync_state"/>
                                    <field name="sync_message" optional="hide"/>
                                    <field name="activity_line_id"/>
                                    <field name="employee_id_external"/>
                                    <field name="employee_name"/>
                                    <field name="employee_farm_identification_code" optional="hide"/>
                                    <field name="plot_code" optional="hide"/>
                                    <field name="worked_surface" optional="hide"/>
                                    <field name="employee_time"/>
                                    <field name="employee_id" optional="hide"/>
                                    <field name="analytic_line_id" optional="hide"/>
                                    <field name="raw_json_text" invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
