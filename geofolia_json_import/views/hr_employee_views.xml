<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_inherit_geofolia" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.geofolia</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Geofolia" name="geofolia" groups="geofolia_json_import.group_geofolia_import">
                    <field name="geofolia_external_id"/>
                    <field name="geofolia_first_name" readonly="1"/>
                    <field name="geofolia_national_identification_code" readonly="1"/>
                    <field name="geofolia_specific_number" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_view_list_inherit_geofolia" model="ir.ui.view">
        <field name="name">hr.employee.list.inherit.geofolia</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="geofolia_external_id" string="Geofolia ID" optional="show" groups="geofolia_json_import.group_geofolia_import"/>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_view_search_inherit_geofolia" model="ir.ui.view">
        <field name="name">hr.employee.search.inherit.geofolia</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='name']" position="after">
                <field name="geofolia_external_id" groups="geofolia_json_import.group_geofolia_import"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="from_geofolia" string="From Geofolia"
                        domain="[('geofolia_external_id', '!=', False)]"
                        groups="geofolia_json_import.group_geofolia_import"/>
            </xpath>
        </field>
    </record>
</odoo>
