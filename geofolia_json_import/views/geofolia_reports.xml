<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Import Jobs reports -->
    <record id="geofolia_import_job_view_pivot" model="ir.ui.view">
        <field name="name">geofolia.import.job.pivot</field>
        <field name="model">geofolia.import.job</field>
        <field name="arch" type="xml">
            <pivot string="Import Jobs" display_quantity="true">
                <field name="import_type" type="row"/>
                <field name="state" type="col"/>
                <field name="apply_state" type="col"/>
                <field name="date_range_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="geofolia_import_job_view_graph" model="ir.ui.view">
        <field name="name">geofolia.import.job.graph</field>
        <field name="model">geofolia.import.job</field>
        <field name="arch" type="xml">
            <graph string="Import Jobs" type="bar">
                <field name="import_type"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="geofolia_import_job_view_calendar" model="ir.ui.view">
        <field name="name">geofolia.import.job.calendar</field>
        <field name="model">geofolia.import.job</field>
        <field name="arch" type="xml">
            <calendar string="Import Jobs" date_start="create_date" date_stop="create_date"
                      color="import_type" mode="month">
                <field name="name"/>
                <field name="import_type"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="action_report_geofolia_import_job" model="ir.actions.act_window">
        <field name="name">Import Jobs</field>
        <field name="res_model">geofolia.import.job</field>
        <field name="groups_id" eval="[(4, ref('geofolia_json_import.group_geofolia_import'))]"/>
        <field name="view_mode">pivot,graph,calendar,list</field>
        <field name="view_ids"
               eval="[(5, 0),
                      (0, 0, {'view_mode': 'pivot', 'view_id': ref('geofolia_import_job_view_pivot')}),
                      (0, 0, {'view_mode': 'graph', 'view_id': ref('geofolia_import_job_view_graph')}),
                      (0, 0, {'view_mode': 'calendar', 'view_id': ref('geofolia_import_job_view_calendar')}),
                      (0, 0, {'view_mode': 'list', 'view_id': ref('geofolia_json_import.view_geofolia_import_job_list')})]"/>
    </record>

    <!-- Timesheets (analytic lines from Geofolia) -->
    <record id="account_analytic_line_geofolia_view_pivot" model="ir.ui.view">
        <field name="name">account.analytic.line.geofolia.pivot</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <pivot string="Timesheets (Geofolia)" display_quantity="true">
                <field name="employee_id" type="row"/>
                <field name="task_id" type="row"/>
                <field name="ter_parcel_id" type="row"/>
                <field name="project_id" type="col"/>
                <field name="geofolia_operation_category" type="col"/>
                <field name="unit_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="account_analytic_line_geofolia_view_graph" model="ir.ui.view">
        <field name="name">account.analytic.line.geofolia.graph</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <graph string="Timesheets (Geofolia)" type="bar">
                <field name="employee_id"/>
                <field name="geofolia_operation_category"/>
                <field name="ter_parcel_id"/>
                <field name="unit_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="account_analytic_line_geofolia_view_calendar" model="ir.ui.view">
        <field name="name">account.analytic.line.geofolia.calendar</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <calendar string="Timesheets (Geofolia)" date_start="date" date_stop="date"
                      color="employee_id" mode="month">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="unit_amount"/>
            </calendar>
        </field>
    </record>

    <record id="action_report_geofolia_timesheet" model="ir.actions.act_window">
        <field name="name">Timesheets (Geofolia)</field>
        <field name="res_model">account.analytic.line</field>
        <field name="groups_id" eval="[(4, ref('geofolia_json_import.group_geofolia_import'))]"/>
        <field name="view_mode">pivot,graph,calendar,list</field>
        <field name="view_ids"
               eval="[(5, 0),
                      (0, 0, {'view_mode': 'pivot', 'view_id': ref('account_analytic_line_geofolia_view_pivot')}),
                      (0, 0, {'view_mode': 'graph', 'view_id': ref('account_analytic_line_geofolia_view_graph')}),
                      (0, 0, {'view_mode': 'calendar', 'view_id': ref('account_analytic_line_geofolia_view_calendar')})]"/>
        <field name="domain">[('geofolia_external_id', '!=', False)]</field>
    </record>

    <!-- Tasks (Geofolia harvested products) -->
    <record id="project_task_geofolia_view_pivot" model="ir.ui.view">
        <field name="name">project.task.geofolia.pivot</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <pivot string="Tasks (Geofolia)" display_quantity="true">
                <field name="project_id" type="row"/>
                <field name="geofolia_botanical_species_name" type="row"/>
                <field name="user_ids" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="project_task_geofolia_view_graph" model="ir.ui.view">
        <field name="name">project.task.geofolia.graph</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <graph string="Tasks (Geofolia)" type="bar">
                <field name="project_id"/>
                <field name="geofolia_botanical_species_name"/>
            </graph>
        </field>
    </record>

    <record id="project_task_geofolia_view_calendar" model="ir.ui.view">
        <field name="name">project.task.geofolia.calendar</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <calendar string="Tasks (Geofolia)" date_start="date_deadline" date_stop="date_deadline"
                      color="project_id" mode="month">
                <field name="name"/>
                <field name="project_id"/>
                <field name="user_ids"/>
            </calendar>
        </field>
    </record>

    <record id="action_report_geofolia_task" model="ir.actions.act_window">
        <field name="name">Tasks (Geofolia)</field>
        <field name="res_model">project.task</field>
        <field name="groups_id" eval="[(4, ref('geofolia_json_import.group_geofolia_import'))]"/>
        <field name="view_mode">pivot,graph,calendar,list</field>
        <field name="view_ids"
               eval="[(5, 0),
                      (0, 0, {'view_mode': 'pivot', 'view_id': ref('project_task_geofolia_view_pivot')}),
                      (0, 0, {'view_mode': 'graph', 'view_id': ref('project_task_geofolia_view_graph')}),
                      (0, 0, {'view_mode': 'calendar', 'view_id': ref('project_task_geofolia_view_calendar')})]"/>
        <field name="domain">[('geofolia_harvest_id', '!=', False)]</field>
    </record>

    <!-- Maintenance requests (Geofolia) -->
    <record id="maintenance_request_geofolia_view_pivot" model="ir.ui.view">
        <field name="name">maintenance.request.geofolia.pivot</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <pivot string="Maintenance (Geofolia)" display_quantity="true">
                <field name="project_id" type="row"/>
                <field name="maintenance_type" type="col"/>
                <field name="stage_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="maintenance_request_geofolia_view_graph" model="ir.ui.view">
        <field name="name">maintenance.request.geofolia.graph</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <graph string="Maintenance (Geofolia)" type="bar">
                <field name="project_id"/>
                <field name="maintenance_type"/>
            </graph>
        </field>
    </record>

    <record id="maintenance_request_geofolia_view_calendar" model="ir.ui.view">
        <field name="name">maintenance.request.geofolia.calendar</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <calendar string="Maintenance (Geofolia)" date_start="schedule_date" date_stop="schedule_date"
                      color="maintenance_type" mode="month">
                <field name="name"/>
                <field name="maintenance_type"/>
                <field name="stage_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_report_geofolia_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance (Geofolia)</field>
        <field name="res_model">maintenance.request</field>
        <field name="groups_id" eval="[(4, ref('geofolia_json_import.group_geofolia_import'))]"/>
        <field name="view_mode">pivot,graph,calendar,list</field>
        <field name="view_ids"
               eval="[(5, 0),
                      (0, 0, {'view_mode': 'pivot', 'view_id': ref('maintenance_request_geofolia_view_pivot')}),
                      (0, 0, {'view_mode': 'graph', 'view_id': ref('maintenance_request_geofolia_view_graph')}),
                      (0, 0, {'view_mode': 'calendar', 'view_id': ref('maintenance_request_geofolia_view_calendar')})]"/>
        <field name="domain">[('geofolia_action_id', '!=', False)]</field>
    </record>

    <!-- Geofolia Reports menu (under base_ter Reports) -->
    <menuitem id="menu_geofolia_reports"
              name="Geofolia"
              parent="base_ter.menu_informes"
              sequence="50"
              groups="geofolia_json_import.group_geofolia_import"/>

    <menuitem id="menu_geofolia_reports_imports"
              name="Imports"
              parent="menu_geofolia_reports"
              action="action_report_geofolia_import_job"
              sequence="10"
              groups="geofolia_json_import.group_geofolia_import"/>

    <menuitem id="menu_geofolia_reports_timesheets"
              name="Timesheets"
              parent="menu_geofolia_reports"
              action="action_report_geofolia_timesheet"
              sequence="20"
              groups="geofolia_json_import.group_geofolia_import"/>

    <menuitem id="menu_geofolia_reports_tasks"
              name="Tasks"
              parent="menu_geofolia_reports"
              action="action_report_geofolia_task"
              sequence="30"
              groups="geofolia_json_import.group_geofolia_import"/>

    <menuitem id="menu_geofolia_reports_maintenance"
              name="Maintenance"
              parent="menu_geofolia_reports"
              action="action_report_geofolia_maintenance"
              sequence="40"
              groups="geofolia_json_import.group_geofolia_import"/>
</odoo>
