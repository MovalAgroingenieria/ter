<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form_inherit_base_ter_geofolia" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.base_ter.geofolia</field>
            <field name="model">res.config.settings</field>

            <!-- IMPORTANT: heredar de la vista de base_ter, no de base -->
            <field name="inherit_id" ref="base_ter.res_config_settings_view_form"/>

            <field name="arch" type="xml">
                <xpath expr="//app[@name='base_ter']" position="inside">
                    <block title="Geofolia" name="base_ter_geofolia">
                        <setting id="geofolia_timesheet_project"
                                 string="Geofolia timesheet project"
                                 help="Project used to create timesheet entries from Geofolia activities.">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="geofolia_timesheet_project_id" options="{'no_create': False}"/>
                                </div>
                            </div>
                        </setting>

                        <setting id="geofolia_timesheet_task"
                                 string="Geofolia timesheet task (fallback)"
                                 help="Default task when activity has no operation name. Otherwise tasks are created automatically from OperationName/OperationCategory.">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="geofolia_timesheet_task_id"
                                           domain="[('project_id', '=', geofolia_timesheet_project_id)]"
                                           options="{'no_create': False}"/>
                                </div>
                            </div>
                        </setting>

                        <setting id="geofolia_default_date_range"
                                 string="Geofolia default campaign"
                                 help="Default campaign (date range) for ter.unit created from Geofolia Fields.">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="geofolia_default_date_range_id" options="{'no_create': False}"/>
                                </div>
                            </div>
                        </setting>

                        <setting id="geofolia_default_municipality"
                                 string="Geofolia default municipality"
                                 help="Default municipality for ter.parcel created from Geofolia Fields (farm level).">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="geofolia_default_municipality_id" options="{'no_create': False}"/>
                                </div>
                            </div>
                        </setting>

                        <setting id="geofolia_maintenance_project"
                                 string="Geofolia maintenance project"
                                 help="Project for maintenance equipment and requests. Enable 'Timesheets' for employee time tracking.">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="geofolia_maintenance_project_id" options="{'no_create': False}"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
