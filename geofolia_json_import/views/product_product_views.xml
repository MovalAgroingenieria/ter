<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_view_form_inherit_geofolia" model="ir.ui.view">
        <field name="name">product.product.form.inherit.geofolia</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Geofolia" name="geofolia">
                    <group>
                        <group string="Identification">
                            <field name="geofolia_external_id"/>
                            <field name="geofolia_recognition_id" readonly="1"/>
                            <field name="geofolia_source" readonly="1"/>
                            <field name="geofolia_rn_reference_supply_name" readonly="1"/>
                            <field name="geofolia_rn_reference_supply_code" readonly="1"/>
                            <field name="geofolia_unit_symbol" readonly="1"/>
                            <field name="geofolia_product_form_enum" readonly="1"/>
                        </group>
                        <group string="Components">
                            <field name="geofolia_product_component_n_total"/>
                            <field name="geofolia_product_component_p2o5"/>
                            <field name="geofolia_product_component_k2o"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
