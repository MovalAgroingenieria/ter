<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ter_parcel_view_form" model="ir.ui.view">
        <field name="name">ter.parcel.view.form.base_ter_invoicing</field>
        <field name="model">ter.parcel</field>
        <field name="inherit_id" ref="base_ter.ter_parcel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_gis_viewer']" position="after">
                <button name="action_show_move_lines"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        groups="account.group_account_invoice,account.group_account_readonly">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_value">
                            <field name="currency_id" invisible="1"/>
                            <field name="total_invoiced" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                        </span>
                        <span class="o_stat_text">Invoiced</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='percentage']" position="after">
                <field name="area_ownership" string="🡸 Area"/>
                <field name="percentage_overhead" string="% Overhead"/>
                <field name="area_overhead" string="🡸 Area"/>
            </xpath>
        </field>
    </record>

    <record id="ter_parcel_partnerlink_view_tree" model="ir.ui.view">
        <field name="name">ter.parcel.partnerlink.view.list.base_ter_invoicing</field>
        <field name="model">ter.parcel.partnerlink</field>
        <field name="inherit_id" ref="base_ter.ter_parcel_partnerlink_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='percentage']" position="after">
                <field name="percentage_overhead" string="% Overhead"/>
            </xpath>
        </field>
    </record>

</odoo>