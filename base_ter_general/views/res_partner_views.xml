<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">base_ter_general.res_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_ter.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="map_base_entity"
                    type="object"
                    string="Map Base"
                    class="oe_stat_button"
                    icon="fa-rotate-right"
                    invisible="context.get('context_no_ter', False) or not mapped_to_base"
                    groups="base_ter.group_ter_manager"
                />
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>
                    <field
                        name="mapped_to_base"
                        invisible="context.get('context_no_ter', False)"
                    />
                </group>
            </xpath>

            <xpath expr="//page[@name='internal_notes']" position="after">
                <page
                    name="connection_params"
                    string="Connection"
                    invisible="not mapped_to_base"
                >
                    <field name="mapped_to_base" invisible="1"/>
                    <group name="connection_params_group">
                        <group name="server" string="Server">
                            <field
                                name="base_connection_host"
                                placeholder="http(s)://host_or_ip"
                            />
                            <field name="base_connection_port" placeholder="0"/>
                        </group>
                        <group name="database" string="Database">
                            <field name="base_connection_database"/>
                            <field name="base_connection_username"/>
                            <field name="base_connection_password" password="1"/>
                        </group>
                        <group name="company" string="Company">
                            <field name="base_connection_company_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_tree" model="ir.ui.view">
        <field name="name">base_ter_general.res_partner_view_tree</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_ter.res_partner_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_code']" position="before">
                <header>
                    <button
                        name="map_base_entity"
                        string="Map Base"
                        type="object"
                        class="btn-primary"
                        icon="fa-rotate-right"
                        groups="base_ter.group_ter_manager"
                    />
                </header>
            </xpath>

            <xpath expr="//field[@name='area_official_parcels']" position="after">
                <field
                    name="mapped_to_base"
                    string="Mapped"
                    class="text-center"
                    optional="show"
                />
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_search" model="ir.ui.view">
        <field name="name">base_ter_general.res_partner_view_search</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_ter.res_partner_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter
                    name="mapped_to_base_yes"
                    string="Partner Primary"
                    domain="[('mapped_to_base', '=', True)]"
                />
                <filter
                    name="mapped_to_base_no"
                    string="Partner Secondary"
                    domain="[('mapped_to_base', '=', False)]"
                />
                <separator/>
            </xpath>
        </field>
    </record>

    <record id="base_ter.res_partner_action" model="ir.actions.act_window">
        <field name="context">{'search_default_mapped_to_base_yes': 1}</field>
    </record>
</odoo>
