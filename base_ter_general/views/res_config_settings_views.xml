<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">base_ter_general.res_config_settings_view_form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_ter.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='base_ter']/block[@name='base_ter_warnings']" position="after">
                <block title="Mapping" name="base_ter_general_mapping">
                    <setting
                        id="base_ter_general_jinja2_template"
                        string="Jinja2 template"
                        help="Template used to render the partner information for secondary parcels."
                    >
                        <div class="content-group">
                            <div class="mt16">
                                <field name="jinja2_template" widget="textarea" class="w-100"/>
                            </div>
                            <div class="text-muted mt8">
                                Use {{ partner.attributes }} to access partner fields.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
