<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ter_parcel_view_form" model="ir.ui.view">
        <field name="name">ter.parcel.view.form.base_ter_general</field>
        <field name="model">ter.parcel</field>
        <field name="inherit_id" ref="base_ter.ter_parcel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='master_data_right']" position="after">
                <group name="mapping_data">
                    <!-- attrs="{'invisible': [('is_secondary', '=', False)]}"> -->
                    <div name="section_basic_data" colspan="2"
                            class="text-center mt-3 mb-4">
                        <p style="width:100%" class="border p-2 fw-bold">MAPPING DATA</p>
                    </div>
                    <field name="mapped_from_base" />
                    <field name="last_update" />
                </group>
            </xpath>
            <xpath expr="//page[@name='page_partnerlinks']" position="before">
                <page name="partner_info" string="Partner Information">
                    <!-- attrs="{'invisible': [('is_secondary', '=', False)]}"> -->
                    <field name="partner_info" class="o_full_width"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="ter_parcel_view_tree" model="ir.ui.view">
        <field name="name">ter.parcel.view.tree.base_ter_general</field>
        <field name="model">ter.parcel</field>
        <field name="inherit_id" ref="base_ter.ter_parcel_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='area_official']" position="after">
                <field name="is_secondary" class="text-center" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="ter_parcel_view_search" model="ir.ui.view">
        <field name="name">ter.parcel.view.search.base_ter_general</field>
        <field name="model">ter.parcel</field>
        <field name="inherit_id" ref="base_ter.ter_parcel_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="filter[@name='inactive']" position="before">
                <filter name="is_secondary_no"
                        string="Primary"
                        domain="[('is_secondary', '=', False)]"/>
                <filter name="is_secondary_yes"
                        string="Secondary"
                        domain="[('is_secondary', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

</odoo>