<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ter_parcel_view_form" model="ir.ui.view">
        <field name="name">base_ter_general.ter_parcel_view_form</field>
        <field name="model">ter.parcel</field>
        <field name="inherit_id" ref="base_ter.ter_parcel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_id']" position="after">
                <field name="is_secondary"/>
            </xpath>

            <xpath expr="//group[@name='master_data_right']" position="after">
                <group name="mapping_data" invisible="not mapped_from_base">
                    <field name="mapped_from_base"/>
                    <field name="last_update"/>
                </group>
            </xpath>

            <xpath expr="//page[@name='page_partnerlinks']" position="before">
                <page
                    name="partner_info"
                    string="Partner Information (Base Entity)"
                    invisible="not mapped_from_base"
                >
                    <field name="partner_info" class="o_full_width"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="ter_parcel_view_list" model="ir.ui.view">
        <field name="name">base_ter_general.ter_parcel_view_list</field>
        <field name="model">ter.parcel</field>
        <field name="inherit_id" ref="base_ter.ter_parcel_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='area_official']" position="after">
                <field name="is_secondary" class="text-center" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="ter_parcel_view_search" model="ir.ui.view">
        <field name="name">base_ter_general.ter_parcel_view_search</field>
        <field name="model">ter.parcel</field>
        <field name="inherit_id" ref="base_ter.ter_parcel_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter
                    name="is_secondary_no"
                    string="Primary"
                    domain="[('is_secondary', '=', False)]"
                />
                <filter
                    name="is_secondary_yes"
                    string="Secondary"
                    domain="[('is_secondary', '=', True)]"
                />
                <separator/>
                <filter
                    name="mapped_yes"
                    string="Mapped: Yes"
                    domain="[('mapped_from_base', '=', True)]"
                />
                <filter
                    name="mapped_no"
                    string="Mapped: No"
                    domain="[('mapped_from_base', '=', False)]"
                />
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
