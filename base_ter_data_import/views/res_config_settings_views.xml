<odoo>

    <record id="res_config_settings_view_form_inherit_catalogs" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.base_ter_data_import</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_ter.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='base_ter']" position="inside">
                <block title="Catalog import" name="base_ter_catalog_import"
                       invisible="not show_catalog_import_wizard">
                    <setting id="base_ter_catalog_import_wizard_info"
                             string="Import territory catalogs">
                        <div class="alert alert-info mb0" role="alert">
                            <p class="mb8">Territory catalogs are imported from local CSV
                                files in the module. You can run the import now.</p>
                            <button name="action_open_import_catalog_csv_wizard"
                                    string="Import catalogs from CSV"
                                    type="object"
                                    class="btn btn-primary"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
